		function activateCaseStudy(caseId: string, isHistoryEvent = false) {
			if (!isHistoryEvent) {
				history.pushState(
					{
						modal: "modal-page-cases",
						view: "detail",
						caseId: caseId,
					},
					"",
					"#modal-page-cases-" + caseId,
				);
			}
			// Switch to detail view
			if (casesGridView) casesGridView.style.display = "none";
			if (casesDetailView) casesDetailView.style.display = "flex";
			document
				.getElementById("modal-page-cases")
				?.classList.add("is-detail");

			// Activate sub-tab
			csSubtabs.forEach((tab) => {
				tab.classList.toggle(
					"is-active",
					tab.getAttribute("data-case-tab") === caseId,
				);
			});

			// Activate sidebar item
			csSidebarItems.forEach((item) => {
				item.classList.toggle(
					"is-active",
					item.getAttribute("data-case-tab") === caseId,
				);
			});

			// Show active pane
			csPanes.forEach((pane) => {
				pane.classList.toggle(
					"is-active",
					pane.id === `cs-pane-${caseId}`,
				);
			});

			if (casesMobileTitle) {
				casesMobileTitle.innerHTML = `${caseTitleMap[caseId] || "Cup Cases"} <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>`;
			}
			document
				.querySelectorAll<HTMLElement>(
					"#modal-page-cases .mobile-tab-menu-item",
				)
				.forEach((item) => {
					item.classList.toggle(
						"is-active",
						item.dataset.mobileTabLabel === caseTitleMap[caseId],
					);
				});
		}

		function returnToGrid() {
			if (casesGridView) casesGridView.style.display = "";
			if (casesDetailView) casesDetailView.style.display = "none";
			document
				.getElementById("modal-page-cases")
				?.classList.remove("is-detail");
			if (casesMobileTitle) {
				casesMobileTitle.innerHTML =
					'Cup Cases <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
			}
		}

