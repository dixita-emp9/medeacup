			"touchstart",
			(event) => {
				mobileTouchStartX = event.touches[0]?.clientX || 0;
			},
			{ passive: true },
		);
		mobileHomeContent?.addEventListener(
			"touchend",
			(event) => {
				const endX = event.changedTouches[0]?.clientX || 0;
				const distance = endX - mobileTouchStartX;
				if (Math.abs(distance) < 45) return;
				setMobileHomeSlide(
					distance < 0 ? "thinking" : "home",
					distance < 0 ? "right" : "left",
				);
			},
