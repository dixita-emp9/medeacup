			.getElementById("mobile-take-quiz")
			?.addEventListener("click", () => {
				quizModal?.classList.add("is-open");
			});
		document
			.getElementById("close-quiz-modal")
			?.addEventListener("click", () =>
				quizModal?.classList.remove("is-open"),
			);
		document
			.getElementById("btn-close-quiz-dot")
			?.addEventListener("click", () =>
				quizModal?.classList.remove("is-open"),
			);
		quizModal?.addEventListener("click", (e) => {
			if (e.target === quizModal) quizModal.classList.remove("is-open");
		});

		document
			.getElementById("video-window-preview")
			?.addEventListener("click", openVideoModal);
		document
			.getElementById("about-showreel-btn")
			?.addEventListener("click", (event) => {
				const showreel = event.currentTarget as HTMLElement;
				if (showreel.querySelector("iframe")) return;
				const iframe = document.createElement("iframe");
				iframe.src = videoSource;
				iframe.title = "MEDEACUP Brand Showcase Video";
				iframe.allow =
					"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
				iframe.allowFullscreen = true;
				Object.assign(iframe.style, {
					position: "absolute",
					top: "0",
					left: "0",
					width: "100%",
					height: "100%",
					border: "0",
					zIndex: "3",
				});
				showreel.classList.add("is-playing");
				showreel.appendChild(iframe);
			});
		document
			.getElementById("about-showreel-btn")
			?.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					(event.currentTarget as HTMLElement).click();
				}
			});
		document
			.getElementById("video-play-button")
			?.addEventListener("click", openVideoModal);
		document
			.getElementById("close-video-modal")
			?.addEventListener("click", closeVideoModal);
		videoModal?.addEventListener("click", (e) => {
			if (e.target === videoModal) closeVideoModal();
		});

		// ──────────────────────────────────────────────────
		// 8. Bottom Dock Controls
		// ──────────────────────────────────────────────────
		const isMobileViewport = () =>
			window.matchMedia("(max-width: 900px)").matches;
		const openMobilePage = (id: string, source: HTMLElement) => {
			const modal = document.getElementById(id);
			if (modal) openModalWithGenie(modal, source);
		};
		const toggleContactPanel = () => {
			const contactPanel = document.getElementById("contact-panel");
			if (!contactPanel) return;
			const isOpen = contactPanel.classList.contains("is-open");
			contactPanel.classList.toggle("is-open", !isOpen);
			contactPanel.setAttribute("aria-hidden", String(isOpen));
		};

		document
			.querySelectorAll<HTMLElement>("[data-top-action]")
			.forEach((control) => {
				const activate = () => {
					if (control.dataset.topAction === "home")
						openMobilePage("modal-page-about", control);
				};
				control.addEventListener("click", activate);
				control.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") {
						event.preventDefault();
						activate();
					}
				});
			});

		document.querySelectorAll<HTMLElement>(".dock-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				const dockId = btn.getAttribute("data-dock-id");
				document
					.querySelectorAll<HTMLElement>(".dock-btn")
					.forEach((dockBtn) => {
						dockBtn.classList.remove("is-active", "is-active-home");
					});
				btn.classList.add("is-active");
				if (isMobileViewport()) {
					if (dockId === "dock-home") {
						window.scrollTo({ top: 0, behavior: "smooth" });
						btn.classList.add("is-active-home");
						return;
					}
					if (dockId === "dock-folder") {
						return;
					}
					if (dockId === "dock-bulb") {
						const quizModal = document.getElementById("quiz-modal");
						quizModal?.classList.add("is-open");
						return;
					}
				}
				let targetWinId = "win-mission";
				if (dockId === "dock-percent") {
					const principleModal = document.getElementById(
						"modal-page-principle",
					);
					if (principleModal) openModalWithGenie(principleModal, btn);
					return;
				} else if (dockId === "dock-folder")
					targetWinId = "win-projects";
				else if (dockId === "dock-bulb") {
					const quizModal = document.getElementById("quiz-modal");
					quizModal?.classList.add("is-open");
					return;
				} else if (dockId === "dock-mail") {
					toggleContactPanel();
					return;
				}

				const tw = document.getElementById(targetWinId);
				if (tw) {
					tw.classList.remove("is-minimized");
					activeZIndex++;
					tw.style.zIndex = String(activeZIndex);
				}
			});
		});

		// ──────────────────────────────────────────────────
		// 9. Cup Framework Interactions
		// ──────────────────────────────────────────────────
		const fwNavItems =
			document.querySelectorAll<HTMLElement>(".fw-nav-item");
		const fwPopovers =
			document.querySelectorAll<HTMLElement>(".fw-popover-card");

		function alignFrameworkPointer(target: string) {
			const navItem = document.querySelector<HTMLElement>(
				`.fw-nav-item[data-fw-target="${target}"]`,
			);
			const popover = document.getElementById(`fw-popover-${target}`);
			if (!navItem || !popover) return;

			requestAnimationFrame(() => {
				const navRect = navItem.getBoundingClientRect();
				const popoverRect = popover.getBoundingClientRect();
				popover.style.setProperty(
					"--fw-arrow-top",
					`${navRect.top + navRect.height / 2 - popoverRect.top}px`,
				);
			});
		}

		// Toggle pop-over on left sidebar click
		fwNavItems.forEach((item) => {
			item.addEventListener("click", () => {
				const target = item.getAttribute("data-fw-target");

				// Deactivate all icons & pop-overs first
				fwNavItems.forEach((n) => n.classList.remove("is-active"));
				fwPopovers.forEach((p) => p.classList.remove("is-active"));

				if (target) {
					item.classList.add("is-active");
					const popover = document.getElementById(
						`fw-popover-${target}`,
					);
					if (popover) {
						popover.classList.add("is-active");
						alignFrameworkPointer(target);
					}
				}
			});
		});

		// Match the reference composition on first open: the middle framework card is featured.
		requestAnimationFrame(() => alignFrameworkPointer("uncommon"));

		// Close pop-over via X button
		document
			.querySelectorAll<HTMLElement>(".fw-pop-close")
			.forEach((btn) => {
				btn.addEventListener("click", (e) => {
					e.stopPropagation(); // prevent bubbling to other elements
					fwNavItems.forEach((n) => n.classList.remove("is-active"));
					fwPopovers.forEach((p) => p.classList.remove("is-active"));
				});
			});

		// ──────────────────────────────────────────────────
		// 10. Core Capabilities Search + Accordion
		// ──────────────────────────────────────────────────
		const capabilitiesModal = document.getElementById(
			"modal-page-capabilities",
		);
		const capabilityRows = Array.from(
			capabilitiesModal?.querySelectorAll<HTMLElement>(
				".capability-row",
			) ?? [],
		);
		const capabilitySearch =
			capabilitiesModal?.querySelector<HTMLInputElement>(
				"[data-capabilities-search]",
			);
		const capabilityNavButtons = Array.from(
			capabilitiesModal?.querySelectorAll<HTMLButtonElement>(
				"[data-capability-nav]",
			) ?? [],
		);

		const filterCapabilities = (query = "") => {
			const normalizedQuery = query.trim().toLowerCase();
			capabilityRows.forEach((row) => {
				const matchesQuery =
					!normalizedQuery ||
					row.textContent?.toLowerCase().includes(normalizedQuery);
				row.hidden = !matchesQuery;
			});
		};

		capabilitySearch?.addEventListener("input", () =>
			filterCapabilities(capabilitySearch.value),
		);
		capabilityNavButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const targetId = button.dataset.capabilityNav;
				if (targetId === "home") {
					history.replaceState(
						null,
						"",
						window.location.pathname + window.location.search,
					);
					if (capabilitiesModal) closeModalWithGenie(capabilitiesModal);
					return;
				}

				const targetModal = targetId
					? document.getElementById(targetId)
					: null;
				if (!targetModal) return;
				if (targetId === "modal-page-cases") returnToGrid();
				history.replaceState(
					{ modal: targetId },
					"",
					"#" + targetId,
				);
				if (capabilitiesModal)
					closeModalWithGenie(capabilitiesModal, true);
				window.setTimeout(
					() => openModalWithGenie(targetModal, button, true),
					40,
				);
			});
		});

		capabilityRows.forEach((row) => {
			const header = row.querySelector<HTMLButtonElement>(
				".capability-row-header",
			);
			header?.addEventListener("click", () => {
				const expanded = row.classList.toggle("is-expanded");
				header.setAttribute("aria-expanded", String(expanded));
				const chevron = header.querySelector<HTMLElement>(
					".capability-chevron",
				);
				if (chevron) chevron.textContent = expanded ? "⌃" : "⌄";
			});
		});

		const whereFilters = document.querySelectorAll<HTMLElement>(
			"#modal-page-where .where-sector-filters button",
		);
		const whereDots = document.querySelectorAll<HTMLElement>(
			"#modal-page-where [data-where-dot]",
		);
		const whereCards = document.querySelectorAll<HTMLElement>(
			"#modal-page-where [data-where-client]",
		);
		const whereTags = document.querySelectorAll<HTMLElement>(
			"#modal-page-where [data-where-tag]",
		);

		const updateWhereSelection = (clients: string[]) => {
			const selected = new Set(clients);
			whereCards.forEach((card) => {
				card.classList.toggle(
					"is-highlighted",
					selected.has(card.dataset.whereClient || ""),
				);
			});
			whereDots.forEach((dot) => {
				dot.classList.toggle(
					"is-selected",
					selected.has(dot.dataset.whereDot || ""),
				);
			});
			whereTags.forEach((tag) => {
				tag.classList.toggle(
					"is-visible",
					selected.has(tag.dataset.whereTag || ""),
				);
			});
		};

		whereDots.forEach((dot) => {
			dot.addEventListener("click", () => {
				const client = dot.dataset.whereDot;
				if (client) updateWhereSelection([client]);
			});
		});

		whereFilters.forEach((filter) => {
			filter.addEventListener("click", () => {
				whereFilters.forEach((button) =>
					button.classList.remove("is-active"),
				);
				filter.classList.add("is-active");
				const sector = filter.dataset.whereSector;
				if (!sector) return;
				const matchingClients = Array.from(whereCards)
					.filter((card) =>
						(card.dataset.whereSectors || "")
							.split(",")
							.includes(sector),
					)
					.map((card) => card.dataset.whereClient || "")
					.filter(Boolean);
				updateWhereSelection(matchingClients);
			});
		});

		// Close contact panel when clicking outside
			document.addEventListener("click", (e) => {
				const contactPanel = document.getElementById("contact-panel");
				const dockMailBtn = document.querySelector<HTMLElement>(
					'[data-dock-id="dock-mail"]',
				);
				const headerMailBtn = document.querySelector<HTMLElement>(
					'[data-top-action="mail"]',
				);
				if (
					contactPanel?.classList.contains("is-open") &&
					!contactPanel.contains(e.target as Node) &&
					e.target !== dockMailBtn &&
					!dockMailBtn?.contains(e.target as Node) &&
					e.target !== headerMailBtn &&
					!headerMailBtn?.contains(e.target as Node)
				) {
				contactPanel.classList.remove("is-open");
				contactPanel.setAttribute("aria-hidden", "true");
				dockMailBtn?.classList.remove("is-active");
			}
		});

		// ──────────────────────────────────────────────────
		// 11. The 1% Principle — toggle + expand animation
		// ──────────────────────────────────────────────────
		const pplStage = document.getElementById("ppl-stage");
		const pplCheckbox = document.getElementById(
			"ppl-checkbox",
		) as HTMLInputElement | null;
		const pplExpandBtn = document.getElementById("ppl-expand-btn");
		const pplFrameworkCta = document.getElementById("ppl-framework-cta");
		const pplCards = document.querySelectorAll<HTMLElement>(
			"[data-principle-card]",
		);
		const pplInsightCards = document.querySelectorAll<HTMLElement>(
			"#modal-page-principle .ppl-exp-card",
		);
		// Toggle unlock
		if (pplCheckbox && pplStage) {
			pplCheckbox.addEventListener("change", () => {
				if (pplCheckbox.checked) {
					pplStage.classList.add("is-unlocked");
				} else {
					// Locking again also collapses expanded view
					pplStage.classList.remove(
						"is-unlocked",
						"is-selecting",
						"is-expanded",
					);
				}
			});
		}

		// Expand button
		pplExpandBtn?.addEventListener("click", () => {
			pplStage?.classList.add("is-selecting");
		});

		// The expanded principle view can hand off directly to the framework
		// window while preserving the site's shared window transition.
		pplFrameworkCta?.addEventListener("click", (event) => {
			const principleModal = document.getElementById("modal-page-principle");
			const frameworkModal = document.getElementById("modal-page-framework");
			if (!frameworkModal) return;

			returnToFrameworkGrid();
			history.replaceState(
				{ modal: "modal-page-framework" },
				"",
				"#modal-page-framework",
			);
			if (principleModal) closeModalWithGenie(principleModal, true);
			window.setTimeout(
				() =>
					openModalWithGenie(
						frameworkModal,
						event.currentTarget as HTMLElement,
						true,
					),
				40,
			);
		});

		// Choose an icon card to open its matching highlighted insight.
		pplCards.forEach((card) => {
			card.addEventListener("click", () => {
				const selectedIndex = Number(card.dataset.principleCard);
				pplInsightCards.forEach((insightCard, index) => {
					insightCard.classList.toggle(
						"ppl-exp-card--active",
						index === selectedIndex,
					);
				});
				pplStage?.classList.remove("is-selecting");
				pplStage?.classList.add("is-expanded");
			});
		});

		// About Us tabs: keep the editorial page and the Mission/In Practice
		// views in the same window, using the same tab interaction pattern.
		const aboutModal = document.getElementById("modal-page-about");
		const aboutTabs = document.querySelectorAll<HTMLElement>(
			"[data-about-tab]",
		);
		const aboutPanes = document.querySelectorAll<HTMLElement>(
			"[data-about-pane]",
		);
		const aboutBody = aboutModal?.querySelector<HTMLElement>(
			".about-window-body",
		);

		aboutTabs.forEach((tab) => {
			tab.addEventListener("click", () => {
				const selectedTab = tab.dataset.aboutTab ?? "about";
				const isInfoTab = selectedTab !== "about";

				aboutTabs.forEach((item) => {
					const isActive = item === tab;
					item.classList.toggle("is-active", isActive);
					item.setAttribute("aria-selected", String(isActive));
				});
				aboutPanes.forEach((pane) => {
					const isActive = pane.dataset.aboutPane === selectedTab;
					pane.hidden = !isActive;
				});
				aboutBody?.classList.toggle("is-info", isInfoTab);
			});
		});
		document
			.querySelectorAll<HTMLElement>("[data-open-mission]")
			.forEach((action) =>
				action.addEventListener("click", () => {
					const missionModal = document.getElementById("modal-page-mission");
					if (!missionModal) return;

					history.replaceState(
						{ modal: "modal-page-mission" },
						"",
						"#modal-page-mission",
					);
					if (aboutModal) closeModalWithGenie(aboutModal, true);
					window.setTimeout(
						() => openModalWithGenie(missionModal, action, true),
						40,
					);
				}),
			);

		// Mission CTA: return to the desktop workspace and call attention to
		// the Thinking Now window on the home page.
		document
			.querySelectorAll<HTMLElement>("[data-open-thinking]")
			.forEach((action) =>
				action.addEventListener("click", () => {
						const missionModal = document.getElementById("modal-page-mission");
						if (isMobileViewport()) {
							const mobileThinkingPanel = document.querySelector<HTMLElement>(
								'[data-mobile-slide="thinking"] .mobile-recent-panel',
							);
							history.replaceState(null, "", window.location.pathname + window.location.search);
							if (missionModal?.classList.contains("is-open")) {
								closeModalWithGenie(missionModal, true);
							}
							setMobileHomeSlide("thinking");
							mobileThinkingPanel?.classList.remove("is-thinking-highlight");
							window.setTimeout(() => {
								mobileThinkingPanel?.classList.add("is-thinking-highlight");
								window.setTimeout(
									() => mobileThinkingPanel?.classList.remove("is-thinking-highlight"),
									1900,
								);
							}, missionModal?.classList.contains("is-open") ? 440 : 40);
							return;
						}
						const thinkingWindow = document.getElementById("win-projects");
						if (!thinkingWindow) return;

						history.replaceState(null, "", window.location.pathname + window.location.search);
						if (missionModal?.classList.contains("is-open")) {
							closeModalWithGenie(missionModal, true);
						}
						thinkingWindow.classList.remove("is-minimized", "is-thinking-highlight");
						activeZIndex++;
						thinkingWindow.style.zIndex = String(activeZIndex);
						window.setTimeout(() => {
							thinkingWindow.classList.add("is-thinking-highlight");
							window.setTimeout(
								() => thinkingWindow.classList.remove("is-thinking-highlight"),
								1900,
							);
						}, missionModal?.classList.contains("is-open") ? 440 : 40);
				}),
			);

		// ──────────────────────────────────────────────────
		// 10. MacOS Dock Stack Interactions
		// ──────────────────────────────────────────────────
		const dockFolderBtn = document.querySelector<HTMLElement>(
			'[data-dock-id="dock-folder"]',
		);
		const dockStack =
			document.querySelector<HTMLElement>("[data-dock-stack]");
		const dockFanItems = Array.from(
			document.querySelectorAll<HTMLElement>(
				".ds-item:nth-child(-n + 3)",
			),
		);
		let dockHoverTimer: ReturnType<typeof setTimeout> | undefined;
		let dockCloseTimer: ReturnType<typeof setTimeout> | undefined;

		const D2R = Math.PI / 180;
		const pointOnFanArc = (
			center: { x: number; y: number },
			radius: number,
			angle: number,
		) => ({
			x: center.x - radius * Math.cos(angle * D2R),
			y: center.y - radius * Math.sin(angle * D2R),
		});

		const positionDockFan = () => {
			if (!dockFolderBtn || !dockStack) return;
			const buttonRect = dockFolderBtn.getBoundingClientRect();
			const stackRect = dockStack.getBoundingClientRect();
			const origin = {
				x: buttonRect.left + buttonRect.width / 2 - stackRect.left,
				// Start the first card above the dock instead of at the button center.
				y: buttonRect.top - stackRect.top - 28,
			};
			const startAngle = 9;
			const step = 4.5;
			const radius = 1360;
			const firstCenter = {
				x: origin.x + radius * Math.cos(startAngle * D2R),
				y: origin.y + radius * Math.sin(startAngle * D2R),
			};

			dockFanItems.forEach((item, index) => {
				const angle = startAngle + index * step;
				const point = pointOnFanArc(firstCenter, radius, angle);
				item.style.setProperty("--fan-x", `${point.x}px`);
				item.style.setProperty("--fan-y", `${point.y}px`);
				item.style.setProperty("--fan-rotation", `${angle}deg`);
				item.style.transitionDelay = `${index * 34}ms`;
			});
		};

		const openDockFan = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			positionDockFan();
			dockStack?.classList.add("is-open");
		};

		const closeDockFan = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			dockStack?.classList.remove("is-open");
		};

		// Touch devices do not have a reliable hover state, so the folder fan
		// is controlled explicitly by the dock button click on mobile.
		dockFolderBtn?.addEventListener("click", (event) => {
			if (!isMobileViewport()) return;
			event.stopPropagation();
			if (dockStack?.classList.contains("is-open")) {
				closeDockFan();
			} else {
				openDockFan();
			}
		});

		document.addEventListener("click", (e) => {
			const target = e.target as Node;
			if (dockStack?.classList.contains("is-open")) {
				if (
					!dockFolderBtn?.contains(target) &&
					!dockStack.contains(target)
				) {
					closeDockFan();
				}
			}
		});

		const scheduleDockOpen = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			dockHoverTimer = setTimeout(openDockFan, 130);
		};

		const scheduleDockClose = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			dockCloseTimer = setTimeout(closeDockFan, 420);
		};

		dockFolderBtn?.addEventListener("pointerenter", () => {
			if (!isMobileViewport()) scheduleDockOpen();
		});
		dockFolderBtn?.addEventListener("pointerleave", (e) => {
			if (isMobileViewport()) return;
			const related = e.relatedTarget as Node | null;
			if (
				related &&
				(dockFolderBtn.contains(related) ||
					dockFanItems.some((item) => item.contains(related)))
			)
				return;
			scheduleDockClose();
		});
		dockFanItems.forEach((item) => {
			item.addEventListener("pointerenter", () => {
				if (!isMobileViewport()) openDockFan();
			});
			item.addEventListener("pointerleave", (e) => {
				if (isMobileViewport()) return;
				const related = e.relatedTarget as Node | null;
				if (
					related &&
					(dockFolderBtn?.contains(related) ||
						dockFanItems.some((other) => other.contains(related)))
				)
					return;
				scheduleDockClose();
			});
		});
		window.addEventListener("resize", () => {
			if (dockStack?.classList.contains("is-open")) positionDockFan();
		});

		document.querySelectorAll<HTMLElement>(".ds-item").forEach((item) => {
			item.addEventListener("click", (e) => {
				e.stopPropagation(); // prevent clicking the dock button itself
				const targetId = item.getAttribute("data-action-target");
				if (targetId) {
					// 1. Close any currently open full-screen modals first
					document
						.querySelectorAll(".modal-overlay.is-open")
						.forEach((modal) => {
							closeModalWithGenie(modal as HTMLElement);
						});

					// 2. Open the requested modal
					const targetModal = document.getElementById(targetId);
					if (targetModal) {
						if (targetId.startsWith("win-")) {
							targetModal.classList.remove("is-minimized");
							activeZIndex++;
							targetModal.style.zIndex = String(activeZIndex);
						} else {
							openModalWithGenie(targetModal, item);
						}
					}
				}
			});
		});
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initializeApp, { once: true });
	} else {
		initializeApp();
	}
</script>
