---
import Layout from '../layouts/Layout.astro';
import DesktopHeader from '../components/DesktopHeader.astro';
import FolderGrid from '../components/FolderGrid.astro';
import WindowMission from '../components/WindowMission.astro';
import WindowProjects from '../components/WindowProjects.astro';
import WindowQuiz from '../components/WindowQuiz.astro';
import WindowPrinciple from '../components/WindowPrinciple.astro';
import BottomDock from '../components/BottomDock.astro';
import ContactPanel from '../components/ContactPanel.astro';
import VideoModal from '../components/VideoModal.astro';
import QuizModal from '../components/QuizModal.astro';
import IndividualPageModals from '../components/IndividualPageModals.astro';
---

<Layout title="MEDIACUP - Web OS Workspace">
	<main id="desktop-canvas">
		<div class="desktop-stage">
			<DesktopHeader />
			<FolderGrid />
			<WindowMission />
			<WindowProjects />
			<WindowQuiz />
			<WindowPrinciple />
			<BottomDock />
			<ContactPanel />
		</div>

		<VideoModal />
		<QuizModal />
		<IndividualPageModals />
	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const windows = document.querySelectorAll<HTMLElement>('.mac-window');
		let activeZIndex = 100;

		// ──────────────────────────────────────────────────
		// 1. Drag-and-Drop Window Manager
		// ──────────────────────────────────────────────────
		windows.forEach((win) => {
			const header = win.querySelector<HTMLElement>('.window-header');
			if (!header) return;

			let isDragging = false;
			let startX = 0, startY = 0, initialLeft = 0, initialTop = 0;
			let maxLeft = 0, maxTop = 0;

			const bringToFront = () => {
				activeZIndex++;
				win.style.zIndex = String(activeZIndex);
				windows.forEach((w) => w.classList.remove('is-active'));
				win.classList.add('is-active');
			};

			win.addEventListener('pointerdown', bringToFront);

			header.addEventListener('pointerdown', (e: PointerEvent) => {
				if ((e.target as HTMLElement).classList.contains('dot-btn')) return;
				isDragging = true;
				bringToFront();
				win.classList.add('is-dragging');
				header.setPointerCapture(e.pointerId);
				startX = e.clientX;
				startY = e.clientY;
				const cs = window.getComputedStyle(win);
				initialLeft = parseInt(cs.left, 10) || 0;
				initialTop = parseInt(cs.top, 10) || 0;
				maxLeft = window.innerWidth - win.offsetWidth - 10;
				maxTop = window.innerHeight - win.offsetHeight - 70;
			});

			header.addEventListener('pointermove', (e: PointerEvent) => {
				if (!isDragging) return;
				let newLeft = initialLeft + (e.clientX - startX);
				let newTop = initialTop + (e.clientY - startY);
				newLeft = Math.max(10, Math.min(newLeft, maxLeft));
				newTop = Math.max(50, Math.min(newTop, maxTop));
				win.style.left = `${newLeft}px`;
				win.style.top = `${newTop}px`;
			});

			const stopDrag = (e: PointerEvent) => {
				if (!isDragging) return;
				isDragging = false;
				win.classList.remove('is-dragging');
				try { header.releasePointerCapture(e.pointerId); } catch {}
			};
			header.addEventListener('pointerup', stopDrag);
			header.addEventListener('pointercancel', stopDrag);

			const dotRed = win.querySelector<HTMLElement>('.dot-red');
			const dotBlack = win.querySelector<HTMLElement>('.dot-black');
			dotRed?.addEventListener('click', (e) => { e.stopPropagation(); win.classList.add('is-minimized'); });
			dotBlack?.addEventListener('click', (e) => { e.stopPropagation(); win.classList.toggle('is-minimized'); });
		});

		// ──────────────────────────────────────────────────
		// 2. Authentic macOS Dock Genie Effect
		// ──────────────────────────────────────────────────

		// Map to store last source element for each open modal
		const modalSourceMap = new Map<HTMLElement, DOMRect>();

		function geniePolygon(sx: number, sy: number, t: number): string {
			const corners = [
				{ x: 0,   y: 0 },
				{ x: 100, y: 0 },
				{ x: 100, y: 100 },
				{ x: 0,   y: 100 },
			];

			const maxDist = 141.42;
			const dists = corners.map(c => Math.sqrt((c.x - sx) ** 2 + (c.y - sy) ** 2) / maxDist);

			const cProg = dists.map(d => {
				const speed = 0.35 + d * 1.4;
				const raw = Math.min(1, t * speed);
				return 1 - Math.pow(1 - raw, 2.5);
			});

			const pts = corners.map((c, i) => ({
				x: sx + (c.x - sx) * cProg[i],
				y: sy + (c.y - sy) * cProg[i],
			}));

			function midBelly(a: {x:number;y:number}, b: {x:number;y:number}, edgeT: number, outwardDir: {x:number;y:number}) {
				const mx = (a.x + b.x) / 2;
				const my = (a.y + b.y) / 2;
				const bellyAmt = Math.sin(edgeT * Math.PI) * (1 - edgeT) * 22;
				return {
					x: Math.max(0, Math.min(100, mx + outwardDir.x * bellyAmt)),
					y: Math.max(0, Math.min(100, my + outwardDir.y * bellyAmt)),
				};
			}

			const topMid = midBelly(pts[0], pts[1], (cProg[0]+cProg[1])/2, {x:0,y:-1});
			const rightMid = midBelly(pts[1], pts[2], (cProg[1]+cProg[2])/2, {x:1,y:0});
			const botMid = midBelly(pts[2], pts[3], (cProg[2]+cProg[3])/2, {x:0,y:1});
			const leftMid = midBelly(pts[3], pts[0], (cProg[3]+cProg[0])/2, {x:-1,y:0});

			const all = [pts[0], topMid, pts[1], rightMid, pts[2], botMid, pts[3], leftMid];
			return `polygon(${all.map(p => `${p.x.toFixed(2)}% ${p.y.toFixed(2)}%`).join(', ')})`;
		}

		/**
		 * Open any modal overlay with Genie animation from sourceEl
		 */
		function openModalWithGenie(overlayEl: HTMLElement, sourceEl: HTMLElement | null, isHistoryEvent = false) {
			if (!isHistoryEvent) {
				history.pushState({ modal: overlayEl.id }, "", "#" + overlayEl.id);
			}
			const macWin = overlayEl.querySelector('.fullscreen-mac-window, .case-study-mac-window') as HTMLElement;
			if (!macWin) return;

			const srcRect = sourceEl ? sourceEl.getBoundingClientRect() : new DOMRect(window.innerWidth / 2 - 30, window.innerHeight - 60, 60, 60);
			modalSourceMap.set(overlayEl, srcRect);

			overlayEl.classList.add('is-open');
			overlayEl.style.opacity = '0';

			requestAnimationFrame(() => {
				const winRect = macWin.getBoundingClientRect();

				const sx = ((srcRect.left + srcRect.width / 2 - winRect.left) / winRect.width) * 100;
				const sy = ((srcRect.top + srcRect.height / 2 - winRect.top) / winRect.height) * 100;

				overlayEl.animate(
					[{ opacity: 0 }, { opacity: 1 }],
					{ duration: 400, fill: 'forwards', easing: 'ease-out' }
				);

				const steps = 10;
				const keyframes: Keyframe[] = [];
				for (let i = 0; i <= steps; i++) {
					const t = i / steps;
					const eased = 1 - Math.pow(1 - t, 2.2);
					keyframes.push({
						clipPath: geniePolygon(sx, sy, eased),
						opacity: 0.3 + 0.7 * t,
						offset: t,
					});
				}
				keyframes[keyframes.length - 1] = {
					clipPath: 'polygon(0% 0%, 50% 0%, 100% 0%, 100% 50%, 100% 100%, 50% 100%, 0% 100%, 0% 50%)',
					opacity: 1,
					offset: 1,
				};

				const anim = macWin.animate(keyframes, {
					duration: 520,
					easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
					fill: 'forwards',
				});

				anim.onfinish = () => {
					macWin.style.clipPath = '';
				};
			});
		}

		/**
		 * Close any modal overlay with reverse Genie animation
		 */
		function closeModalWithGenie(overlayEl: HTMLElement, isHistoryEvent = false) {
			const macWin = overlayEl.querySelector('.fullscreen-mac-window, .case-study-mac-window') as HTMLElement;
			if (!macWin || !overlayEl.classList.contains('is-open')) return;

			const winRect = macWin.getBoundingClientRect();
			const srcRect = modalSourceMap.get(overlayEl) || new DOMRect(
				window.innerWidth / 2 - 30, window.innerHeight - 60, 60, 60
			);

			const sx = ((srcRect.left + srcRect.width / 2 - winRect.left) / winRect.width) * 100;
			const sy = ((srcRect.top + srcRect.height / 2 - winRect.top) / winRect.height) * 100;

			overlayEl.animate(
				[{ opacity: 1 }, { opacity: 0 }],
				{ duration: 380, fill: 'forwards', easing: 'ease-in' }
			);

			const steps = 10;
			const keyframes: Keyframe[] = [];
			for (let i = 0; i <= steps; i++) {
				const t = i / steps;
				const reverseT = 1 - t;
				const eased = 1 - Math.pow(1 - reverseT, 2.2);
				keyframes.push({
					clipPath: geniePolygon(sx, sy, eased),
					opacity: 1 - 0.7 * t,
					offset: t,
				});
			}
			keyframes[0] = {
				clipPath: 'polygon(0% 0%, 50% 0%, 100% 0%, 100% 50%, 100% 100%, 50% 100%, 0% 100%, 0% 50%)',
				opacity: 1,
				offset: 0,
			};

			const anim = macWin.animate(keyframes, {
				duration: 420,
				easing: 'cubic-bezier(0.55, 0, 1, 0.45)',
				fill: 'forwards',
			});

			anim.onfinish = () => {
				overlayEl.classList.remove('is-open');
				overlayEl.style.opacity = '';
				macWin.style.clipPath = '';

				if (window.matchMedia('(max-width: 900px)').matches) {
					document.querySelectorAll('.dock-btn').forEach(btn => btn.classList.remove('is-active', 'is-active-home'));
					document.querySelector('[data-dock-id="dock-home"]')?.classList.add('is-active', 'is-active-home');
				}
			};
		}

		// ──────────────────────────────────────────────────
		// 3. Folder Click → Open Individual Modal
		// ──────────────────────────────────────────────────
		const folderModalMap: Record<string, string> = {
			principle: 'modal-page-principle',
			cases: 'modal-page-cases',
			framework: 'modal-page-framework',
			capabilities: 'modal-page-capabilities',
			about: 'modal-page-about',
			where: 'modal-page-where',
		};

		document.querySelectorAll<HTMLElement>('.folder-item, .mobile-folder-item, .mobile-principle-card, #win-principle').forEach(folder => {
			folder.addEventListener('click', () => {
				const id = folder.getAttribute('data-folder-id');
				if (id && folderModalMap[id]) {
					const targetOverlay = document.getElementById(folderModalMap[id]);
					if (targetOverlay) openModalWithGenie(targetOverlay, folder);
				}
			});
		});

		// ──────────────────────────────────────────────────
		// 4. Card Action Links → Open Individual Modal
		// ──────────────────────────────────────────────────
		document.getElementById('btn-learn-more')?.addEventListener('click', (e) => {
			const targetOverlay = document.getElementById('modal-page-mission');
			if (targetOverlay) openModalWithGenie(targetOverlay, e.currentTarget as HTMLElement);
		});

		document.querySelectorAll<HTMLElement>('.project-card-item').forEach(card => {
			card.addEventListener('click', (e) => {
				const targetOverlay = document.getElementById('modal-page-cases');
				if (targetOverlay) openModalWithGenie(targetOverlay, e.currentTarget as HTMLElement);
			});
		});

		// ──────────────────────────────────────────────────
		// 5. Cup Cases: Grid ↔ Detail View Switching
		// ──────────────────────────────────────────────────
		const casesGridView = document.getElementById('cases-view-grid');
		const casesDetailView = document.getElementById('cases-view-detail');
		const csSubtabs = document.querySelectorAll<HTMLElement>('.cs-subtab');
		const csSidebarItems = document.querySelectorAll<HTMLElement>('.cs-sidebar-item');
		const csPanes = document.querySelectorAll<HTMLElement>('.cs-pane');
		const casesSearch = document.querySelector<HTMLInputElement>('[data-cases-search]');
		const casesMobileTitle = document.querySelector<HTMLElement>('#modal-page-cases .mobile-nav-title');
		const caseTitleMap: Record<string, string> = {
			fctrylab: 'FCTRYLAB',
			fabindia: 'FabIndia',
			'godrej-interio': 'Godrej Interio',
			'godrej-properties': 'Godrej Properties',
			'reverb-asia': 'Reverb Asia',
		};

		function activateCaseStudy(caseId: string, isHistoryEvent = false) {
			if (!isHistoryEvent) {
				history.pushState({ modal: "modal-page-cases", view: "detail", caseId: caseId }, "", "#modal-page-cases-" + caseId);
			}
			// Switch to detail view
			if (casesGridView) casesGridView.style.display = 'none';
			if (casesDetailView) casesDetailView.style.display = 'flex';
			document.getElementById('modal-page-cases')?.classList.add('is-detail');

			// Activate sub-tab
			csSubtabs.forEach(tab => {
				tab.classList.toggle('is-active', tab.getAttribute('data-case-tab') === caseId);
			});

			// Activate sidebar item
			csSidebarItems.forEach(item => {
				item.classList.toggle('is-active', item.getAttribute('data-case-tab') === caseId);
			});

			// Show active pane
			csPanes.forEach(pane => {
				pane.classList.toggle('is-active', pane.id === `cs-pane-${caseId}`);
			});

			if (casesMobileTitle) {
				casesMobileTitle.innerHTML = `${caseTitleMap[caseId] || 'Cup Cases'} <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>`;
			}
		}

		function returnToGrid() {
			if (casesGridView) casesGridView.style.display = '';
			if (casesDetailView) casesDetailView.style.display = 'none';
			document.getElementById('modal-page-cases')?.classList.remove('is-detail');
			if (casesMobileTitle) {
				casesMobileTitle.innerHTML = 'Cup Cases <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
			}
		}

		function returnToCasesGridFromDetail() {
			returnToGrid();
			history.replaceState({ modal: "modal-page-cases" }, "", "#modal-page-cases");
		}

		casesSearch?.addEventListener('input', () => {
			const query = casesSearch.value.trim().toLowerCase();
			document.querySelectorAll<HTMLElement>('#modal-page-cases .case-doc-item').forEach((item) => {
				item.hidden = Boolean(query) && !item.textContent?.toLowerCase().includes(query);
			});
		});

		// Document icon click → switch to detail view
		document.querySelectorAll<HTMLElement>('.case-doc-item').forEach(item => {
			item.addEventListener('click', () => {
				const caseId = item.getAttribute('data-case-id');
				if (caseId) activateCaseStudy(caseId);
			});
		});

		// Back button click → return to grid
		document.getElementById('cs-back-to-grid')?.addEventListener('click', () => {
			returnToCasesGridFromDetail();
		});

		// Sub-tab click → switch case study
		csSubtabs.forEach(tab => {
			tab.addEventListener('click', (e) => {
				// If clicking the × close button, return to grid
				if ((e.target as HTMLElement).classList.contains('subtab-close')) {
					returnToCasesGridFromDetail();
					return;
				}
				const caseId = tab.getAttribute('data-case-tab');
				if (caseId) activateCaseStudy(caseId);
			});
		});

		// Sidebar click → switch case study
		csSidebarItems.forEach(item => {
			item.addEventListener('click', () => {
				const caseId = item.getAttribute('data-case-tab');
				if (caseId) activateCaseStudy(caseId);
			});
		});

		// ──────────────────────────────────────────────────
		
		// ──────────────────────────────────────────────────
		// 5.5 Cup Framework: Mobile Grid ↔ Detail View Switching
		// ──────────────────────────────────────────────────
		const fwMobileGrid = document.getElementById("fw-mobile-grid");
		const fwDesktopCanvas = document.getElementById("fw-desktop-canvas");
		const fwTitle = document.querySelector("#modal-page-framework .mobile-nav-title");

		function activateFrameworkDetail(caseId, isHistoryEvent = false) {
			if (!isHistoryEvent) {
				history.pushState({ modal: "modal-page-framework", view: "detail", caseId: caseId }, "", "#modal-page-framework-" + caseId);
			}
			// Switch to detail view on mobile
			const modal = document.getElementById("modal-page-framework");
			if (modal) modal.classList.add("is-mobile-detail");

			// Activate corresponding popover card
			document.querySelectorAll("#modal-page-framework .fw-popover-card").forEach(card => {
				card.classList.toggle("is-active", card.id === "fw-popover-" + caseId);
			});

			// Update header title
			if (fwTitle) {
				const titleMap = {
					clarity: "Clarity",
					uncommon: "Uncommon Ideas",
					power: "Power In Market"
				};
				fwTitle.innerHTML = titleMap[caseId] + ' <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
			}
		}

		
		function returnToFrameworkGrid() {
			const modal = document.getElementById("modal-page-framework");
			if (modal) modal.classList.remove("is-mobile-detail");
			document.querySelectorAll("#modal-page-framework .fw-popover-card").forEach(card => card.classList.remove("is-active"));
			if (fwTitle) {
				fwTitle.innerHTML = 'Cup Framework <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
			}
		}

		
		// Framework explicit back button logic
		// Mobile grid document click
		document.querySelectorAll("#fw-mobile-grid .fw-grid-item").forEach(item => {
			item.addEventListener("click", () => {
				const caseId = item.getAttribute("data-fw-target");
				if (caseId) activateFrameworkDetail(caseId);
			});
		});

		// 6. Close Handlers for All Modals
		// ──────────────────────────────────────────────────
		document.querySelectorAll<HTMLElement>('.close-modal-btn').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				const targetId = btn.getAttribute('data-close-target');
				if (targetId === "modal-page-cases" && casesDetailView && casesDetailView.style.display !== "none") {
					returnToCasesGridFromDetail();
					return;
				}
				if (targetId === "modal-page-cases" && casesGridView && casesGridView.style.display !== "none") {
					const casesOverlay = document.getElementById(targetId);
					history.replaceState(null, "", window.location.pathname + window.location.search);
					if (casesOverlay) closeModalWithGenie(casesOverlay);
					return;
				}
				if (window.history.state && window.history.state.modal) {
					window.history.back();
				} else {
					// Fallback
					if (targetId) {
						const targetOverlay = document.getElementById(targetId);
						if (targetOverlay) {
							if (targetId === "modal-page-cases" && casesGridView && casesGridView.style.display === "none") { returnToGrid(); return; }
							if (targetId === "modal-page-framework" && targetOverlay.classList.contains("is-mobile-detail")) { returnToFrameworkGrid(); return; }
							if (targetId === "modal-page-cases") returnToGrid();
							if (targetId === "modal-page-framework") returnToFrameworkGrid();
							closeModalWithGenie(targetOverlay);
						}
					}
				}
			});
		});

		// ──────────────────────────────────────────────────
		// 7. Popstate Event Listener for Browser History
		// ──────────────────────────────────────────────────
		window.addEventListener('popstate', (e) => {
			const state = e.state;

			// If no state, it means we returned to the home page
			if (!state || !state.modal) {
				document.querySelectorAll<HTMLElement>('.modal-overlay.is-open').forEach(modal => {
					// Also reset grids just in case
					if (modal.id === "modal-page-cases") returnToGrid();
					if (modal.id === "modal-page-framework") returnToFrameworkGrid();
					closeModalWithGenie(modal, true);
				});
				return;
			}

			// We have a modal state
			const targetModal = document.getElementById(state.modal);
			if (targetModal) {
				// Ensure the modal is open
				if (!targetModal.classList.contains('is-open')) {
					openModalWithGenie(targetModal, null, true);
				}

				// Handle sub-views
				if (state.view === "detail") {
					if (state.modal === "modal-page-cases") {
						activateCaseStudy(state.caseId, true);
					} else if (state.modal === "modal-page-framework") {
						activateFrameworkDetail(state.caseId, true);
					}
				} else {
					// It's the grid view, so close any active detail view
					if (state.modal === "modal-page-cases") returnToGrid();
					if (state.modal === "modal-page-framework") returnToFrameworkGrid();
				}
			}
		});

		// Close overlays when clicking outside window body
		document.querySelectorAll<HTMLElement>('.modal-overlay').forEach(overlay => {
			overlay.addEventListener('click', (e) => {
				if (e.target === overlay) {
					if (overlay.id === "modal-page-cases") returnToGrid();
					if (overlay.id === "modal-page-framework") returnToFrameworkGrid();
					if (overlay.id === 'modal-page-principle') {
						const checkboxes = overlay.querySelectorAll<HTMLInputElement>('[data-principle-checkbox]');
						const lockedStage = overlay.querySelector<HTMLElement>('[data-principle-stage]');
						const openStage = overlay.querySelector<HTMLElement>('[data-principle-expanded]');
						checkboxes.forEach((checkbox) => { checkbox.checked = false; });
						lockedStage?.classList.remove('is-hidden');
						openStage?.classList.add('is-hidden');
						openStage?.setAttribute('hidden', 'true');
					}
					overlay.classList.remove("is-mobile-detail");
						if (window.history.state && window.history.state.modal === overlay.id) { window.history.back(); } else { closeModalWithGenie(overlay); }
				}
			});
		});

		// ──────────────────────────────────────────────────
		// 7. Quiz & Video Modals
		// ──────────────────────────────────────────────────
		const quizModal = document.getElementById('quiz-modal');
		const videoModal = document.getElementById('video-modal');
		const videoSource = 'https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1';

		function openVideoModal() {
			if (!videoModal) return;
			const container = videoModal.querySelector<HTMLElement>('.video-container');
			if (container && !container.querySelector('iframe')) {
				const iframe = document.createElement('iframe');
				iframe.src = videoSource;
				iframe.title = 'MEDIACUP Brand Showcase Video';
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
				iframe.allowFullscreen = true;
				container.replaceChildren(iframe);
			}
			videoModal.classList.add('is-open');
		}

		document.getElementById('btn-take-quiz')?.addEventListener('click', () => {
			quizModal?.classList.add('is-open');
		});
		document.getElementById('mobile-take-quiz')?.addEventListener('click', () => {
			quizModal?.classList.add('is-open');
		});
		document.getElementById('close-quiz-modal')?.addEventListener('click', () => quizModal?.classList.remove('is-open'));
		document.getElementById('btn-close-quiz-dot')?.addEventListener('click', () => quizModal?.classList.remove('is-open'));
		quizModal?.addEventListener('click', (e) => { if (e.target === quizModal) quizModal.classList.remove('is-open'); });

		document.getElementById('video-file-btn')?.addEventListener('click', () => {
			openVideoModal();
		});
		document.getElementById('about-showreel-btn')?.addEventListener('click', () => {
			openVideoModal();
		});
		document.getElementById('video-play-button')?.addEventListener('click', openVideoModal);
		document.getElementById('close-video-modal')?.addEventListener('click', () => videoModal?.classList.remove('is-open'));
		videoModal?.addEventListener('click', (e) => { if (e.target === videoModal) videoModal.classList.remove('is-open'); });

		// ──────────────────────────────────────────────────
		// 8. Bottom Dock Controls
		// ──────────────────────────────────────────────────
		const isMobileViewport = () => window.matchMedia('(max-width: 900px)').matches;
		const openMobilePage = (id: string, source: HTMLElement) => {
			const modal = document.getElementById(id);
			if (modal) openModalWithGenie(modal, source);
		};

		document.querySelectorAll<HTMLElement>('[data-top-action]').forEach((control) => {
			const activate = () => {
				if (!isMobileViewport()) return;
				if (control.dataset.topAction === 'home') window.scrollTo({ top: 0, behavior: 'smooth' });
				if (control.dataset.topAction === 'mail') document.querySelector<HTMLElement>('[data-dock-id="dock-mail"]')?.click();
			};
			control.addEventListener('click', activate);
			control.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); activate(); }
			});
		});

		document.querySelectorAll<HTMLElement>('.dock-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const dockId = btn.getAttribute('data-dock-id');
				document.querySelectorAll<HTMLElement>('.dock-btn').forEach((dockBtn) => {
					dockBtn.classList.remove('is-active', 'is-active-home');
				});
				btn.classList.add('is-active');
				if (isMobileViewport()) {
					if (dockId === 'dock-home') {
						window.scrollTo({ top: 0, behavior: 'smooth' });
						btn.classList.add('is-active-home');
						return;
					}
					if (dockId === 'dock-folder') {
						const dockStack = document.querySelector('[data-dock-stack]');
						if (dockStack) {
							dockStack.classList.toggle('is-open');
						}
						return;
					}
					if (dockId === 'dock-bulb') {
						openMobilePage('modal-page-framework', btn);
						return;
					}
				}
				let targetWinId = 'win-mission';
				if (dockId === 'dock-percent') {
					const principleModal = document.getElementById('modal-page-principle');
					if (principleModal) openModalWithGenie(principleModal, btn);
					return;
				}
				else if (dockId === 'dock-folder') targetWinId = 'win-projects';
				else if (dockId === 'dock-bulb') targetWinId = 'win-quiz';
				else if (dockId === 'dock-mail') {
					const contactPanel = document.getElementById('contact-panel');
					const isOpen = contactPanel?.classList.contains('is-open');
					if (isOpen) {
						contactPanel?.classList.remove('is-open');
						contactPanel?.setAttribute('aria-hidden', 'true');
						btn.classList.remove('is-active');
					} else {
						contactPanel?.classList.add('is-open');
						contactPanel?.setAttribute('aria-hidden', 'false');
					}
					return;
				}

				const tw = document.getElementById(targetWinId);
				if (tw) {
					tw.classList.remove('is-minimized');
					activeZIndex++;
					tw.style.zIndex = String(activeZIndex);
				}
			});
		});

		// ──────────────────────────────────────────────────
		// 9. Cup Framework Interactions
		// ──────────────────────────────────────────────────
		const fwNavItems = document.querySelectorAll<HTMLElement>('.fw-nav-item');
		const fwPopovers = document.querySelectorAll<HTMLElement>('.fw-popover-card');

		function alignFrameworkPointer(target: string) {
			const navItem = document.querySelector<HTMLElement>(`.fw-nav-item[data-fw-target="${target}"]`);
			const popover = document.getElementById(`fw-popover-${target}`);
			if (!navItem || !popover) return;

			requestAnimationFrame(() => {
				const navRect = navItem.getBoundingClientRect();
				const popoverRect = popover.getBoundingClientRect();
				popover.style.setProperty('--fw-arrow-top', `${navRect.top + navRect.height / 2 - popoverRect.top}px`);
			});
		}

		// Toggle pop-over on left sidebar click
		fwNavItems.forEach(item => {
			item.addEventListener('click', () => {
				const target = item.getAttribute('data-fw-target');
				
				// Deactivate all icons & pop-overs first
				fwNavItems.forEach(n => n.classList.remove('is-active'));
				fwPopovers.forEach(p => p.classList.remove('is-active'));

				if (target) {
					item.classList.add('is-active');
					const popover = document.getElementById(`fw-popover-${target}`);
					if (popover) {
						popover.classList.add('is-active');
						alignFrameworkPointer(target);
					}
				}
			});
		});

		// Close pop-over via X button
		document.querySelectorAll<HTMLElement>('.fw-pop-close').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation(); // prevent bubbling to other elements
				fwNavItems.forEach(n => n.classList.remove('is-active'));
				fwPopovers.forEach(p => p.classList.remove('is-active'));
			});
		});

		// ──────────────────────────────────────────────────
		// 10. Core Capabilities Search + Accordion
		// ──────────────────────────────────────────────────
		const capabilitiesModal = document.getElementById('modal-page-capabilities');
		const capabilityRows = Array.from(capabilitiesModal?.querySelectorAll<HTMLElement>('.capability-row') ?? []);
		const capabilitySearch = capabilitiesModal?.querySelector<HTMLInputElement>('[data-capabilities-search]');
		const capabilityFilters = Array.from(capabilitiesModal?.querySelectorAll<HTMLElement>('[data-capability-filter]') ?? []);

		const filterCapabilities = (query = '', category = 'all') => {
			const normalizedQuery = query.trim().toLowerCase();
			capabilityRows.forEach((row) => {
				const matchesCategory = category === 'all' || row.dataset.capability === category;
				const matchesQuery = !normalizedQuery || row.textContent?.toLowerCase().includes(normalizedQuery);
				row.hidden = !(matchesCategory && matchesQuery);
			});
		};

		capabilitySearch?.addEventListener('input', () => filterCapabilities(capabilitySearch.value));
		capabilityFilters.forEach((filter) => {
			filter.addEventListener('click', () => {
				capabilityFilters.forEach((button) => button.classList.remove('is-active'));
				filter.classList.add('is-active');
				filterCapabilities(capabilitySearch?.value ?? '', filter.dataset.capabilityFilter ?? 'all');
			});
		});

		capabilityRows.forEach((row) => {
			const header = row.querySelector<HTMLButtonElement>('.capability-row-header');
			header?.addEventListener('click', () => {
				const expanded = row.classList.toggle('is-expanded');
				header.setAttribute('aria-expanded', String(expanded));
				const chevron = header.querySelector<HTMLElement>('.capability-chevron');
				if (chevron) chevron.textContent = expanded ? '⌃' : '⌄';
			});
		});

		const whereFilters = document.querySelectorAll<HTMLElement>('#modal-page-where .where-sector-filters button');
		whereFilters.forEach((filter) => {
			filter.addEventListener('click', () => {
				whereFilters.forEach((button) => button.classList.remove('is-active'));
				filter.classList.add('is-active');
			});
		});

		// Close contact panel when clicking outside
		document.addEventListener('click', (e) => {
			const contactPanel = document.getElementById('contact-panel');
			const dockMailBtn  = document.querySelector<HTMLElement>('[data-dock-id="dock-mail"]');
			if (
				contactPanel?.classList.contains('is-open') &&
				!contactPanel.contains(e.target as Node) &&
				e.target !== dockMailBtn &&
				!dockMailBtn?.contains(e.target as Node)
			) {
				contactPanel.classList.remove('is-open');
				contactPanel.setAttribute('aria-hidden', 'true');
				dockMailBtn?.classList.remove('is-active');
			}
		});

		// ──────────────────────────────────────────────────
		// 11. The 1% Principle — toggle + expand animation
		// ──────────────────────────────────────────────────
		const pplStage     = document.getElementById('ppl-stage');
		const pplCheckbox  = document.getElementById('ppl-checkbox') as HTMLInputElement | null;
		const pplExpandBtn = document.getElementById('ppl-expand-btn');

		// Toggle unlock
		if (pplCheckbox && pplStage) {
			pplCheckbox.addEventListener('change', () => {
				if (pplCheckbox.checked) {
					pplStage.classList.add('is-unlocked');
				} else {
					// Locking again also collapses expanded view
					pplStage.classList.remove('is-unlocked', 'is-expanded');
				}
			});
		}

		// Expand button
		pplExpandBtn?.addEventListener('click', () => {
			pplStage?.classList.add('is-expanded');
		});

		// Reset everything when modal is closed
		const principleModal = document.getElementById('modal-page-principle');
		principleModal?.querySelector('.close-modal-btn')?.addEventListener('click', () => {
			if (pplCheckbox) pplCheckbox.checked = false;
			pplStage?.classList.remove('is-unlocked', 'is-expanded');
		});


		// ──────────────────────────────────────────────────
		// 10. MacOS Dock Stack Interactions
		// ──────────────────────────────────────────────────
		const dockFolderBtn = document.querySelector<HTMLElement>('[data-dock-id="dock-folder"]');
		const dockStack = document.querySelector<HTMLElement>('[data-dock-stack]');
		const dockFanItems = Array.from(document.querySelectorAll<HTMLElement>('.ds-item:nth-child(-n + 3)'));
		let dockHoverTimer: ReturnType<typeof setTimeout> | undefined;
		let dockCloseTimer: ReturnType<typeof setTimeout> | undefined;

		const D2R = Math.PI / 180;
		const pointOnFanArc = (center: { x: number; y: number }, radius: number, angle: number) => ({
			x: center.x - radius * Math.cos(angle * D2R),
			y: center.y - radius * Math.sin(angle * D2R),
		});

		const positionDockFan = () => {
			if (!dockFolderBtn || !dockStack) return;
			const buttonRect = dockFolderBtn.getBoundingClientRect();
			const stackRect = dockStack.getBoundingClientRect();
			const origin = {
				x: buttonRect.left + buttonRect.width / 2 - stackRect.left,
				// Start the first card above the dock instead of at the button center.
				y: buttonRect.top - stackRect.top - 28,
			};
			const startAngle = 9;
			const step = 4.5;
			const radius = 1360;
			const firstCenter = {
				x: origin.x + radius * Math.cos(startAngle * D2R),
				y: origin.y + radius * Math.sin(startAngle * D2R),
			};

			dockFanItems.forEach((item, index) => {
				const angle = startAngle + index * step;
				const point = pointOnFanArc(firstCenter, radius, angle);
				item.style.setProperty('--fan-x', `${point.x}px`);
				item.style.setProperty('--fan-y', `${point.y}px`);
				item.style.setProperty('--fan-rotation', `${angle}deg`);
				item.style.transitionDelay = `${index * 34}ms`;
			});
		};

		const openDockFan = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			positionDockFan();
			dockStack?.classList.add('is-open');
		};

		const closeDockFan = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			dockStack?.classList.remove('is-open');
		};

		document.addEventListener('click', (e) => {
			const target = e.target as Node;
			if (dockStack?.classList.contains('is-open')) {
				if (!dockFolderBtn?.contains(target) && !dockStack.contains(target)) {
					closeDockFan();
				}
			}
		});

		const scheduleDockOpen = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			dockHoverTimer = setTimeout(openDockFan, 130);
		};

		const scheduleDockClose = () => {
			if (dockHoverTimer) clearTimeout(dockHoverTimer);
			if (dockCloseTimer) clearTimeout(dockCloseTimer);
			dockCloseTimer = setTimeout(closeDockFan, 420);
		};

		dockFolderBtn?.addEventListener('pointerenter', scheduleDockOpen);
		dockFolderBtn?.addEventListener('pointerleave', (e) => {
			const related = e.relatedTarget as Node | null;
			if (related && (dockFolderBtn.contains(related) || dockFanItems.some((item) => item.contains(related)))) return;
			scheduleDockClose();
		});
		dockFanItems.forEach((item) => {
			item.addEventListener('pointerenter', openDockFan);
			item.addEventListener('pointerleave', (e) => {
				const related = e.relatedTarget as Node | null;
				if (related && (dockFolderBtn?.contains(related) || dockFanItems.some((other) => other.contains(related)))) return;
				scheduleDockClose();
			});
		});
		window.addEventListener('resize', () => {
			if (dockStack?.classList.contains('is-open')) positionDockFan();
		});

		document.querySelectorAll<HTMLElement>('.ds-item').forEach(item => {
			item.addEventListener('click', (e) => {
				e.stopPropagation(); // prevent clicking the dock button itself
				const targetId = item.getAttribute('data-action-target');
				if (targetId) {
					// 1. Close any currently open full-screen modals first
					document.querySelectorAll('.modal-overlay.is-open').forEach(modal => {
						closeModalWithGenie(modal as HTMLElement);
					});

					// 2. Open the requested modal
					const targetModal = document.getElementById(targetId);
					if (targetModal) {
						if (targetId.startsWith('win-')) {
							targetModal.classList.remove('is-minimized');
							activeZIndex++;
							targetModal.style.zIndex = String(activeZIndex);
						} else {
							openModalWithGenie(targetModal, item);
						}
					}
				}
			});
		});
	});
</script>
