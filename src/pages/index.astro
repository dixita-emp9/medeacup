		// 6. Close Handlers for All Modals
		// ──────────────────────────────────────────────────
		document
			.querySelectorAll<HTMLElement>(".close-modal-btn")
			.forEach((btn) => {
				btn.addEventListener("click", (e) => {
					e.preventDefault();
					const targetId = btn.getAttribute("data-close-target");
					if (targetId === "modal-page-principle") {
						const principleOverlay =
							document.getElementById(targetId);
						if (principleOverlay) {
							resetPrincipleExperience(principleOverlay);
							resetHomePrincipleToggle();
							history.replaceState(
								null,
								"",
								window.location.pathname +
									window.location.search,
							);
							closeModalWithGenie(principleOverlay);
						}
						return;
					}
					if (
						targetId === "modal-page-cases" &&
						casesDetailView &&
						casesDetailView.style.display !== "none"
					) {
						returnToCasesGridFromDetail();
						return;
					}
					if (
						targetId === "modal-page-cases" &&
						casesGridView &&
						casesGridView.style.display !== "none"
					) {
						const casesOverlay = document.getElementById(targetId);
						history.replaceState(
							null,
							"",
							window.location.pathname + window.location.search,
						);
						if (casesOverlay) closeModalWithGenie(casesOverlay);
						return;
					}
					if (window.history.state && window.history.state.modal) {
						window.history.back();
					} else {
						// Fallback
						if (targetId) {
							const targetOverlay =
								document.getElementById(targetId);
							if (targetOverlay) {
								if (
									targetId === "modal-page-cases" &&
									casesGridView &&
									casesGridView.style.display === "none"
								) {
									returnToGrid();
									return;
								}
								if (
									targetId === "modal-page-framework" &&
									targetOverlay.classList.contains(
										"is-mobile-detail",
									)
								) {
									returnToFrameworkGrid();
									return;
								}
								if (targetId === "modal-page-cases")
									returnToGrid();
								if (targetId === "modal-page-framework")
									returnToFrameworkGrid();
								closeModalWithGenie(targetOverlay);
							}
						}
					}
				});
			});

		// ──────────────────────────────────────────────────
		// 7. Popstate Event Listener for Browser History
		// ──────────────────────────────────────────────────
		window.addEventListener("popstate", (e) => {
			const state = e.state;

			// If no state, it means we returned to the home page
			if (!state || !state.modal) {
				document
					.querySelectorAll<HTMLElement>(".modal-overlay.is-open")
					.forEach((modal) => {
						// Also reset grids just in case
						if (modal.id === "modal-page-cases") returnToGrid();
						if (modal.id === "modal-page-framework")
							returnToFrameworkGrid();
						closeModalWithGenie(modal, true);
					});
				return;
			}

			// We have a modal state
			const targetModal = document.getElementById(state.modal);
			if (targetModal) {
				// Ensure the modal is open
				if (!targetModal.classList.contains("is-open")) {
					openModalWithGenie(targetModal, null, true);
				}

				// Handle sub-views
				if (state.view === "detail") {
					if (state.modal === "modal-page-cases") {
						activateCaseStudy(state.caseId, true);
					} else if (state.modal === "modal-page-framework") {
						activateFrameworkDetail(state.caseId, true);
					}
				} else {
					// It's the grid view, so close any active detail view
					if (state.modal === "modal-page-cases") returnToGrid();
					if (state.modal === "modal-page-framework")
						returnToFrameworkGrid();
				}
			}
		});

		// Close overlays when clicking outside window body
		document
			.querySelectorAll<HTMLElement>(".modal-overlay")
			.forEach((overlay) => {
				overlay.addEventListener("click", (e) => {
					if (e.target === overlay) {
						if (overlay.id === "modal-page-cases") returnToGrid();
						if (overlay.id === "modal-page-framework")
							returnToFrameworkGrid();
						if (overlay.id === "modal-page-principle") {
							const checkboxes =
								overlay.querySelectorAll<HTMLInputElement>(
									"[data-principle-checkbox]",
								);
							const lockedStage =
								overlay.querySelector<HTMLElement>(
									"[data-principle-stage]",
								);
							const openStage =
								overlay.querySelector<HTMLElement>(
									"[data-principle-expanded]",
								);
							checkboxes.forEach((checkbox) => {
								checkbox.checked = false;
							});
							lockedStage?.classList.remove("is-hidden");
							openStage?.classList.add("is-hidden");
							openStage?.setAttribute("hidden", "true");
						}
						overlay.classList.remove("is-mobile-detail");
						if (
							window.history.state &&
							window.history.state.modal === overlay.id
						) {
							window.history.back();
						} else {
							closeModalWithGenie(overlay);
						}
					}
				});
			});

		// ──────────────────────────────────────────────────
