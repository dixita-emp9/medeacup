---
import Layout from "../layouts/Layout.astro";
import DesktopHeader from "../components/DesktopHeader.astro";
import FolderGrid from "../components/FolderGrid.astro";
import WindowMission from "../components/WindowMission.astro";
import WindowProjects from "../components/WindowProjects.astro";
import WindowQuiz from "../components/WindowQuiz.astro";
import WindowVideo from "../components/WindowVideo.astro";
import WindowPrinciple from "../components/WindowPrinciple.astro";
import BottomDock from "../components/BottomDock.astro";
import ContactPanel from "../components/ContactPanel.astro";
import VideoModal from "../components/VideoModal.astro";
import QuizModal from "../components/QuizModal.astro";
import IndividualPageModals from "../components/IndividualPageModals.astro";
import ExperienceModal from "../components/ExperienceModal.astro";
---

<Layout title="MEDEACUP - Web OS Workspace">
	<main id="desktop-canvas">
		<div class="desktop-stage">
			<DesktopHeader />
			<FolderGrid />
			<WindowMission />
			<WindowProjects />
			<WindowQuiz />
			<WindowVideo />
			<WindowPrinciple />
			<BottomDock />
			<ContactPanel />
		</div>

		<VideoModal />
		<QuizModal />
		<IndividualPageModals />
		<ExperienceModal />
	</main>
</Layout>

<script>
	const initializeApp = () => {
		const windows = document.querySelectorAll<HTMLElement>(".mac-window");
		let activeZIndex = 100;

		// ──────────────────────────────────────────────────
		// 1. Drag-and-Drop Window Manager
		// ──────────────────────────────────────────────────
		windows.forEach((win) => {
			const header = win.querySelector<HTMLElement>(".window-header");
			if (!header) return;

			let isDragging = false;
			let didDrag = false;
			let suppressNextClick = false;
			let startX = 0,
				startY = 0,
				initialLeft = 0,
				initialTop = 0;
			let maxLeft = 0,
				maxTop = 0;
			let activePointerId: number | null = null;

			const bringToFront = () => {
				activeZIndex++;
				win.style.zIndex = String(activeZIndex);
				windows.forEach((w) => w.classList.remove("is-active"));
				win.classList.add("is-active");
			};

			win.addEventListener("pointerdown", bringToFront);

			header.addEventListener("pointerdown", (e: PointerEvent) => {
				if (!e.isPrimary || e.button !== 0 || isDragging) return;
				if ((e.target as HTMLElement).classList.contains("dot-btn"))
					return;
				isDragging = true;
				activePointerId = e.pointerId;
				didDrag = false;
				bringToFront();
				win.classList.add("is-dragging");
				header.setPointerCapture(e.pointerId);
				header.style.touchAction = "none";
				startX = e.clientX;
				startY = e.clientY;
				const rect = win.getBoundingClientRect();
				const parentRect =
					(
						win.offsetParent as HTMLElement | null
					)?.getBoundingClientRect() ?? new DOMRect(0, 0, 0, 0);
				// Always start from the rendered position. This is important for
				// windows initially anchored with right/bottom rather than left/top.
				// Coordinates must be relative to the desktop canvas, not the viewport.
				initialLeft = rect.left - parentRect.left;
				initialTop = rect.top - parentRect.top;
				// Once a bottom/right-positioned window is dragged, switch it to the
				// same pixel-based coordinates used by the other desktop windows.
				win.style.setProperty("right", "auto", "important");
				win.style.setProperty("bottom", "auto", "important");
				win.style.setProperty("left", `${initialLeft}px`, "important");
				win.style.setProperty("top", `${initialTop}px`, "important");
				maxLeft = (win.offsetParent as HTMLElement | null)?.clientWidth
					? (win.offsetParent as HTMLElement).clientWidth -
						win.offsetWidth -
						10
					: window.innerWidth - win.offsetWidth - 10;
				maxTop = (win.offsetParent as HTMLElement | null)?.clientHeight
					? (win.offsetParent as HTMLElement).clientHeight -
						win.offsetHeight -
						70
					: window.innerHeight - win.offsetHeight - 70;
			});

			header.addEventListener("pointermove", (e: PointerEvent) => {
				if (!isDragging || e.pointerId !== activePointerId) return;
				if (Math.hypot(e.clientX - startX, e.clientY - startY) > 5)
					didDrag = true;
				let newLeft = initialLeft + (e.clientX - startX);
				let newTop = initialTop + (e.clientY - startY);
				newLeft = Math.max(10, Math.min(newLeft, maxLeft));
				newTop = Math.max(50, Math.min(newTop, maxTop));
				win.style.setProperty("left", `${newLeft}px`, "important");
				win.style.setProperty("top", `${newTop}px`, "important");
			});

			const stopDrag = (e?: PointerEvent) => {
				if (!isDragging) return;
				if (e && e.pointerId !== activePointerId) return;
				isDragging = false;
				activePointerId = null;
				if (didDrag) suppressNextClick = true;
				win.classList.remove("is-dragging");
				try {
					if (e && header.hasPointerCapture(e.pointerId)) {
						header.releasePointerCapture(e.pointerId);
					}
				} catch {}
			};
			header.addEventListener("pointerup", stopDrag);
			header.addEventListener("pointercancel", stopDrag);
			header.addEventListener("lostpointercapture", stopDrag);
			document.addEventListener("pointerup", stopDrag);
			document.addEventListener("pointercancel", stopDrag);
			window.addEventListener("blur", () => stopDrag());
			document.addEventListener("visibilitychange", () => {
				if (document.hidden) stopDrag();
			});

			// A drag emits a click on pointer release; swallow only that synthetic click.
			win.addEventListener(
				"click",
				(e) => {
					if (!suppressNextClick) return;
					e.stopPropagation();
					suppressNextClick = false;
				},
				true,
			);

			const dotRed = win.querySelector<HTMLElement>(".dot-red");
			const dotBlack = win.querySelector<HTMLElement>(".dot-black");
			dotRed?.addEventListener("click", (e) => {
				e.stopPropagation();
				win.classList.add("is-minimized");
			});
			dotBlack?.addEventListener("click", (e) => {
				e.stopPropagation();
				win.classList.toggle("is-minimized");
			});
		});

		// ──────────────────────────────────────────────────
		// 2. Authentic macOS Dock Genie Effect
		// ──────────────────────────────────────────────────

		// Map to store last source element for each open modal
		const modalSourceMap = new Map<HTMLElement, DOMRect>();

		function geniePolygon(sx: number, sy: number, t: number): string {
			const corners = [
				{ x: 0, y: 0 },
				{ x: 100, y: 0 },
				{ x: 100, y: 100 },
				{ x: 0, y: 100 },
			];

			const maxDist = 141.42;
			const dists = corners.map(
				(c) => Math.sqrt((c.x - sx) ** 2 + (c.y - sy) ** 2) / maxDist,
			);

			const cProg = dists.map((d) => {
				const speed = 0.35 + d * 1.4;
				const raw = Math.min(1, t * speed);
				return 1 - Math.pow(1 - raw, 2.5);
			});

			const pts = corners.map((c, i) => ({
				x: sx + (c.x - sx) * cProg[i],
				y: sy + (c.y - sy) * cProg[i],
			}));

			function midBelly(
				a: { x: number; y: number },
				b: { x: number; y: number },
				edgeT: number,
				outwardDir: { x: number; y: number },
			) {
				const mx = (a.x + b.x) / 2;
				const my = (a.y + b.y) / 2;
				const bellyAmt = Math.sin(edgeT * Math.PI) * (1 - edgeT) * 22;
				return {
					x: Math.max(0, Math.min(100, mx + outwardDir.x * bellyAmt)),
					y: Math.max(0, Math.min(100, my + outwardDir.y * bellyAmt)),
				};
			}

			const topMid = midBelly(pts[0], pts[1], (cProg[0] + cProg[1]) / 2, {
				x: 0,
				y: -1,
			});
			const rightMid = midBelly(
				pts[1],
				pts[2],
				(cProg[1] + cProg[2]) / 2,
				{ x: 1, y: 0 },
			);
			const botMid = midBelly(pts[2], pts[3], (cProg[2] + cProg[3]) / 2, {
				x: 0,
				y: 1,
			});
			const leftMid = midBelly(
				pts[3],
				pts[0],
				(cProg[3] + cProg[0]) / 2,
				{ x: -1, y: 0 },
			);

			const all = [
				pts[0],
				topMid,
				pts[1],
				rightMid,
				pts[2],
				botMid,
				pts[3],
				leftMid,
			];
			return `polygon(${all.map((p) => `${p.x.toFixed(2)}% ${p.y.toFixed(2)}%`).join(", ")})`;
		}

		function resetPrincipleExperience(overlayEl: HTMLElement) {
			if (overlayEl.id !== "modal-page-principle") return;

			const checkbox =
				overlayEl.querySelector<HTMLInputElement>("#ppl-checkbox");
			const stage = overlayEl.querySelector<HTMLElement>("#ppl-stage");
			if (checkbox) checkbox.checked = false;
			stage?.classList.remove(
				"is-unlocked",
				"is-selecting",
				"is-expanded",
			);
			overlayEl
				.querySelectorAll<HTMLElement>("[data-principle-tab]")
				.forEach((tab) => {
					const isPrincipleTab =
						tab.dataset.principleTab === "principle";
					tab.classList.toggle("is-active", isPrincipleTab);
					 tab.setAttribute("aria-selected", String(isPrincipleTab));
				});
			const mobileTitle = overlayEl.querySelector<HTMLElement>(
				".mobile-nav-title",
			);
			if (mobileTitle?.firstChild) {
				mobileTitle.firstChild.textContent = "The 1% Principle ";
			}
		}

		function resetHomePrincipleToggle() {
			const homeToggle = document.getElementById(
				"toggle-unlock-1percent",
			) as HTMLInputElement | null;
			if (homeToggle) homeToggle.checked = false;
		}

		// Reset before any 1% launch control opens the modal. This also covers
		// alternate launch paths that do not use the shared modal opener.
		document.addEventListener("click", (event) => {
			const target = event.target as Element | null;
			if (
				!target?.closest(
					'[data-folder-id="principle"], [data-dock-id="dock-percent"]',
				)
			)
				return;

			const principleOverlay = document.getElementById(
				"modal-page-principle",
			);
			if (principleOverlay) resetPrincipleExperience(principleOverlay);
		});

		/**
		 * Open any modal overlay with Genie animation from sourceEl
		 */
		function openModalWithGenie(
			overlayEl: HTMLElement,
			sourceEl: HTMLElement | null,
			isHistoryEvent = false,
		) {
			resetPrincipleExperience(overlayEl);
			if (overlayEl.id === "modal-page-framework") {
				overlayEl.classList.remove("is-experience-tab");
				overlayEl
					.querySelector<HTMLElement>("#fw-desktop-canvas")
					?.removeAttribute("hidden");
				const experiencePanel = overlayEl.querySelector<HTMLElement>(
					"#fw-experience-panel",
				);
				if (experiencePanel) experiencePanel.hidden = true;
				overlayEl
					.querySelectorAll<HTMLElement>("[data-framework-tab]")
					.forEach((tab) => {
						const isFrameworkTab =
							tab.dataset.frameworkTab === "framework";
						tab.classList.toggle("is-active", isFrameworkTab);
					});
			}

			if (!isHistoryEvent) {
				history.pushState(
					{ modal: overlayEl.id },
					"",
					"#" + overlayEl.id,
				);
			}
			const macWin = overlayEl.querySelector(
				".fullscreen-mac-window, .case-study-mac-window",
			) as HTMLElement;
			if (!macWin) return;

			const srcRect = sourceEl
				? sourceEl.getBoundingClientRect()
				: new DOMRect(
						window.innerWidth / 2 - 30,
						window.innerHeight - 60,
						60,
						60,
					);
			modalSourceMap.set(overlayEl, srcRect);

			overlayEl.classList.add("is-open");
			overlayEl.style.opacity = "0";

			requestAnimationFrame(() => {
				const winRect = macWin.getBoundingClientRect();

				const sx =
					((srcRect.left + srcRect.width / 2 - winRect.left) /
						winRect.width) *
					100;
				const sy =
					((srcRect.top + srcRect.height / 2 - winRect.top) /
						winRect.height) *
					100;

				overlayEl.animate([{ opacity: 0 }, { opacity: 1 }], {
					duration: 400,
					fill: "forwards",
					easing: "ease-out",
				});

				const steps = 10;
				const keyframes: Keyframe[] = [];
				for (let i = 0; i <= steps; i++) {
					const t = i / steps;
					const eased = 1 - Math.pow(1 - t, 2.2);
					keyframes.push({
						clipPath: geniePolygon(sx, sy, eased),
						opacity: 0.3 + 0.7 * t,
						offset: t,
					});
				}
				keyframes[keyframes.length - 1] = {
					clipPath:
						"polygon(0% 0%, 50% 0%, 100% 0%, 100% 50%, 100% 100%, 50% 100%, 0% 100%, 0% 50%)",
					opacity: 1,
					offset: 1,
				};

				const anim = macWin.animate(keyframes, {
					duration: 520,
					easing: "cubic-bezier(0.16, 1, 0.3, 1)",
					fill: "forwards",
				});

				anim.onfinish = () => {
					macWin.style.clipPath = "";
				};
			});
		}

		/**
		 * Close any modal overlay with reverse Genie animation
		 */
		function closeModalWithGenie(
			overlayEl: HTMLElement,
			isHistoryEvent = false,
		) {
			const macWin = overlayEl.querySelector(
				".fullscreen-mac-window, .case-study-mac-window",
			) as HTMLElement;
			if (!macWin || !overlayEl.classList.contains("is-open")) return;

			const winRect = macWin.getBoundingClientRect();
			const srcRect =
				modalSourceMap.get(overlayEl) ||
				new DOMRect(
					window.innerWidth / 2 - 30,
					window.innerHeight - 60,
					60,
					60,
				);

			const sx =
				((srcRect.left + srcRect.width / 2 - winRect.left) /
					winRect.width) *
				100;
			const sy =
				((srcRect.top + srcRect.height / 2 - winRect.top) /
					winRect.height) *
				100;

			overlayEl.animate([{ opacity: 1 }, { opacity: 0 }], {
				duration: 380,
				fill: "forwards",
				easing: "ease-in",
			});

			const steps = 10;
			const keyframes: Keyframe[] = [];
			for (let i = 0; i <= steps; i++) {
				const t = i / steps;
				const reverseT = 1 - t;
				const eased = 1 - Math.pow(1 - reverseT, 2.2);
				keyframes.push({
					clipPath: geniePolygon(sx, sy, eased),
					opacity: 1 - 0.7 * t,
					offset: t,
				});
			}
			keyframes[0] = {
				clipPath:
					"polygon(0% 0%, 50% 0%, 100% 0%, 100% 50%, 100% 100%, 50% 100%, 0% 100%, 0% 50%)",
				opacity: 1,
				offset: 0,
			};

			const anim = macWin.animate(keyframes, {
				duration: 420,
				easing: "cubic-bezier(0.55, 0, 1, 0.45)",
				fill: "forwards",
			});

			anim.onfinish = () => {
				overlayEl.classList.remove("is-open");
				overlayEl.style.opacity = "";
				macWin.style.clipPath = "";
				resetPrincipleExperience(overlayEl);
				if (overlayEl.id === "modal-page-principle")
					resetHomePrincipleToggle();

				if (window.matchMedia("(max-width: 900px)").matches) {
					document
						.querySelectorAll(".dock-btn")
						.forEach((btn) =>
							btn.classList.remove("is-active", "is-active-home"),
						);
					document
						.querySelector('[data-dock-id="dock-home"]')
						?.classList.add("is-active", "is-active-home");
				}
			};
		}

		// ──────────────────────────────────────────────────
		// 3. Folder Click → Open Individual Modal
		// ──────────────────────────────────────────────────
		const folderModalMap: Record<string, string> = {
			mission: "modal-page-mission",
			principle: "modal-page-principle",
			cases: "modal-page-cases",
			experience: "modal-page-experience",
			framework: "modal-page-framework",
			capabilities: "modal-page-capabilities",
			about: "modal-page-about",
			where: "modal-page-where",
		};

			document
				.querySelectorAll<HTMLElement>(
					".folder-item, .mobile-folder-item, .mobile-recent-shortcut, .mobile-principle-card, #win-principle",
			)
			.forEach((folder) => {
				folder.addEventListener("click", () => {
					const id = folder.getAttribute("data-folder-id");
					if (id === "video") {
						openVideoModal();
						return;
					}
					if (id && folderModalMap[id]) {
						if (id === "experience") {
							document
								.getElementById("experience-view-grid")
								?.removeAttribute("hidden");
							document
								.getElementById("experience-view-detail")
								?.setAttribute("hidden", "true");
						}
						const targetOverlay = document.getElementById(
							folderModalMap[id],
						);
						if (targetOverlay)
							openModalWithGenie(targetOverlay, folder);
					}
				});
				});

		// Mobile modal navigation: the centered title and the three-dot button
		// expose the same tabs that are visible in the desktop window header.
		// Pages without tabs get a small page switcher instead.
		const mobilePageLabels: Record<string, string> = {
			mission: "Our Mission",
			principle: "The 1% Principle",
			cases: "Cup Cases",
			experience: "Experience Design",
			framework: "Cup Framework",
			capabilities: "What we build",
			about: "About Us",
			where: "Where We Work",
		};

		document
			.querySelectorAll<HTMLElement>(".modal-overlay")
			.forEach((overlay) => {
				const nav = overlay.querySelector<HTMLElement>(".mobile-modal-nav");
				const title = nav?.querySelector<HTMLElement>(".mobile-nav-title");
				const more = nav?.querySelector<HTMLElement>(".mobile-nav-more");
				if (!nav || !title || !more) return;

				const menu = document.createElement("div");
				menu.className = "mobile-tab-menu";
				menu.hidden = true;
				menu.setAttribute("aria-label", "Page navigation");

				const desktopTabStrip = overlay.id === "modal-page-experience"
					? null
					: overlay.querySelector<HTMLElement>(
							".principle-tabbar, .browser-tab-strip, .about-tabbar",
						);
				const desktopTabs = desktopTabStrip
					? Array.from(
							desktopTabStrip.querySelectorAll<HTMLElement>(
								"[data-principle-tab], [data-framework-tab], [data-about-tab]",
							),
					  )
					: [];

				const addMenuItem = (
					label: string,
					action: () => void,
					isActive = false,
				) => {
					const item = document.createElement("button");
					item.type = "button";
					item.className = "mobile-tab-menu-item";
					item.textContent = label;
					item.dataset.mobileTabLabel = label;
					item.classList.toggle("is-active", isActive);
					item.addEventListener("click", (event) => {
						event.stopPropagation();
						action();
						menu.hidden = true;
						title.setAttribute("aria-expanded", "false");
					});
					menu.appendChild(item);
				};

				if (overlay.id === "modal-page-cases") {
					const caseMenuItems = [
						["fctrylab", "FCTRYLAB"],
						["fabindia", "FabIndia"],
						["godrej-interio", "Godrej Interio"],
						["godrej-properties", "Godrej Properties"],
						["reverb-asia", "Reverb Asia"],
					] as const;
					caseMenuItems.forEach(([caseId, label]) => {
						addMenuItem(
							label,
							() => overlay
								.querySelector<HTMLElement>(
									`.case-doc-item[data-case-id="${caseId}"], [data-case-tab="${caseId}"]`,
								)
								?.click(),
							Boolean(
								overlay.querySelector(`#cs-pane-${caseId}.is-active`),
							),
						);
					});
				} else if (overlay.id === "modal-page-experience") {
					overlay.querySelectorAll<HTMLElement>("[data-experience-tab]").forEach((experienceTab) => {
						const label = experienceTab.dataset.experienceTab || experienceTab.textContent?.trim() || "";
						addMenuItem(label, () => experienceTab.click(), experienceTab.classList.contains("is-active"));
					});
				} else if (desktopTabs.length) {
					desktopTabs.forEach((desktopTab) => {
						const label = (desktopTab.textContent || "")
							.replace(/×/g, "")
							.trim();
						addMenuItem(label, () => desktopTab.click(), desktopTab.classList.contains("is-active"));
					});
				} else {
					Object.entries(folderModalMap).forEach(([id, targetId]) => {
						if (targetId === overlay.id) return;
						addMenuItem(mobilePageLabels[id], () => {
							const target = document.getElementById(targetId);
							if (!target) return;
							closeModalWithGenie(overlay, true);
							window.setTimeout(() => openModalWithGenie(target, null, true), 40);
						});
					});
				}

				nav.appendChild(menu);
				const toggleMenu = (event: Event) => {
					event.stopPropagation();
					menu.hidden = !menu.hidden;
					title.setAttribute("aria-expanded", String(!menu.hidden));
				};
				title.setAttribute("role", "button");
				title.setAttribute("tabindex", "0");
				title.setAttribute("aria-expanded", "false");
				title.addEventListener("click", toggleMenu);
				title.addEventListener("keydown", (event) => {
					if (event.key === "Enter" || event.key === " ") toggleMenu(event);
				});
				more.addEventListener("click", toggleMenu);
			});

		document.addEventListener("click", (event) => {
			if ((event.target as Element).closest(".mobile-modal-nav")) return;
			document.querySelectorAll<HTMLElement>(".mobile-tab-menu").forEach((menu) => {
				menu.hidden = true;
				menu.closest(".mobile-modal-nav")?.querySelector(".mobile-nav-title")?.setAttribute("aria-expanded", "false");
			});
		});

		// Mobile home has two deliberate slides: the folder/quiz home and Recent
		// Projects. The dots and horizontal swipe both use the
		// same state so the active indicator never drifts from the visible page.
		const mobileHomeSlides = document.querySelectorAll<HTMLElement>(
			"[data-mobile-slide]",
		);
		const mobileHomeDots = document.querySelectorAll<HTMLButtonElement>(
			"[data-mobile-slide-dot]",
		);
		let activeMobileSlide = "home";
		const setMobileHomeSlide = (
			slideId: string,
			enteringFrom?: "left" | "right",
		) => {
			if (!mobileHomeSlides.length) return;
			const nextMobileSlide = slideId === "thinking" ? "thinking" : "home";
			if (nextMobileSlide === activeMobileSlide) return;
			const transitionDirection =
				enteringFrom ?? (nextMobileSlide === "home" ? "left" : "right");
			activeMobileSlide = nextMobileSlide;
			mobileHomeSlides.forEach((slide) => {
				const isActive = slide.dataset.mobileSlide === activeMobileSlide;
				slide.classList.toggle("is-active", isActive);
				slide.classList.remove("is-entering-from-right", "is-entering-from-left");
				if (isActive)
					slide.classList.add(`is-entering-from-${transitionDirection}`);
				slide.setAttribute("aria-hidden", String(!isActive));
			});
			mobileHomeDots.forEach((dot) => {
				const isActive = dot.dataset.mobileSlideDot === activeMobileSlide;
				dot.classList.toggle("is-active", isActive);
				dot.setAttribute("aria-selected", String(isActive));
			});
		};
