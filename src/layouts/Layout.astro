---
interface Props {
	title?: string;
}

const { title = "MEDIACUP - Desktop OS Workspace" } = Astro.props;
import '../styles/global.css';
---

<!css>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="MEDIACUP Interactive Desktop Workspace - We find the 1% your market is waiting for." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" /></noscript>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:inline>
			html, body { margin: 0; width: 100%; min-height: 100%; background: #fff; }
			#desktop-canvas { position: relative; width: 100%; min-height: 100vh; overflow: hidden; }
			.desktop-stage { position: relative; width: 100%; height: 100vh; }
			.desktop-header { position: absolute; top: 30px; left: 0; right: 0; height: 80px; display: flex; align-items: center; justify-content: space-between; padding: 0 48px; z-index: 5; }
			.logo-text { display: inline-block; color: #e62e2d; font-family: Arial, sans-serif; font-size: 42px; font-weight: 800; letter-spacing: -0.02em; }
			.top-status-dots { display: flex; align-items: center; gap: 14px; }
			.status-circle { width: 36px; height: 36px; border-radius: 50%; background: #eae5d7; }
			@media (max-width: 900px) {
				.desktop-header { top: 34px; height: 62px; padding: 0 40px; }
				.logo-text { font-size: clamp(28px, 7.6vw, 40px); letter-spacing: -0.055em; }
				.top-status-dots { gap: 12px; }
				.status-circle { width: 54px; height: 54px; background: #383838; }
			}
		</style>
		<script is:inline>
			(() => {
				const deferStylesheet = (link) => {
					if (!link.media && link.href.includes('/_astro/')) {
						link.media = 'print';
						link.addEventListener('load', () => { link.media = 'all'; }, { once: true });
					}
				};
				const scan = () => document.head.querySelectorAll('link[rel="stylesheet"]').forEach(deferStylesheet);
				new MutationObserver(scan).observe(document.head, { childList: true });
				scan();
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
