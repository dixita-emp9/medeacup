---
interface Props {
	title?: string;
	description?: string;
	keywords?: string;
}

const {
	title = "MedeaCup | Creative Intelligence & Growth Strategy Company",
	description =
		"Creative intelligence and growth strategy company helping brands turn market intelligence, creative ideas and customer experience into commercial growth.",
	keywords =
		"creative intelligence company, creative strategy, growth strategy, brand strategy, market intelligence, experience design, creative intelligence company in India, creative strategy and growth company, strategic growth partner for brands",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const organizationSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			name: "MedeaCup",
			url: canonicalUrl,
			logo: new URL("/medeacup-logo.png", canonicalUrl).href,
			description,
		},
		{
			"@type": "WebSite",
			name: "MedeaCup",
			url: canonicalUrl,
			description,
		},
	],
};
import "../styles/global.css";
import Preloader from "../components/Preloader.astro";
import ScreenSaver from "../components/ScreenSaver.astro";
---

<!--css-->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="MedeaCup" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#f5f2ec" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MedeaCup" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL("/medeacup-logo.png", canonicalUrl).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/medeacup-logo.png", canonicalUrl).href} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-KETSY0PH65"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-KETSY0PH65');
		</script>
	</head>
	<body>
		<Preloader />
		<ScreenSaver />
		<div id="cup-cursor" aria-hidden="true">
			<svg viewBox="0 0 40 48" xmlns="http://www.w3.org/2000/svg">
				<line class="cup-cursor-steam" x1="13" y1="7" x2="13" y2="2"
				></line>
				<line class="cup-cursor-steam" x1="20" y1="5" x2="20" y2="0"
				></line>
				<line class="cup-cursor-steam" x1="27" y1="7" x2="27" y2="2"
				></line>
				<line class="cup-cursor-rim" x1="4" y1="11" x2="36" y2="11"
				></line>
				<path
					class="cup-cursor-fill"
					d="M6 11 L9 40 Q9 43 12 43 L28 43 Q31 43 31 40 L34 11 Z"
				></path>
				<path
					class="cup-cursor-handle"
					d="M31 19 Q41 19 41 27 Q41 35 31 35"></path>
			</svg>
		</div>
		<slot />
	</body>
</html>

<script>
	const cupCursor = document.getElementById("cup-cursor");
	const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

	if (cupCursor && finePointer.matches) {
		document.body.classList.add("has-cup-cursor");

		let mouseX = -100;
		let mouseY = -100;
		let cursorX = mouseX;
		let cursorY = mouseY;

		const isOpaque = (color: string) => {
			const match = color.match(/rgba?\(([^)]+)\)/);
			if (!match) return false;
			const parts = match[1]
				.split(",")
				.map((part) => Number.parseFloat(part.trim()));
			// Ignore translucent modal/backdrop layers; keep walking until we find
			// the solid surface the cursor is actually sitting on.
			return parts.length < 4 || parts[3] > 0.75;
		};

		const isDarkTone = (color: string) => {
			const match = color.match(/rgba?\(([^)]+)\)/);
			if (!match) return false;
			const [red, green, blue] = match[1]
				.split(",")
				.map((part) => Number.parseFloat(part.trim()));
			if ([red, green, blue].some((value) => Number.isNaN(value)))
				return false;
			const isBrandRed =
				red > 130 && red > green * 1.65 && red > blue * 1.65;
			const luminance =
				(0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255;
			return isBrandRed || luminance < 0.42;
		};

		const updateTone = (event: MouseEvent) => {
			const element = document.elementFromPoint(
				event.clientX,
				event.clientY,
			) as HTMLElement | null;
			if (!element) return;

			let node: HTMLElement | null = element;
			let dark = false;
			while (node && node !== document.body) {
				const explicitTone = node.dataset.cursorTone;
				if (explicitTone) {
					dark = explicitTone === "dark";
					break;
				}
				const background =
					window.getComputedStyle(node).backgroundColor;
				if (isOpaque(background)) {
					dark = isDarkTone(background);
					break;
				}
				node = node.parentElement;
			}
			document.body.classList.toggle("cup-cursor-dark", dark);
		};

		document.addEventListener("mousemove", (event) => {
			mouseX = event.clientX;
			mouseY = event.clientY;
			cupCursor.classList.add("is-visible");
			const target = event.target as HTMLElement | null;
			document.body.classList.toggle(
				"cup-cursor-hover",
				Boolean(
					target?.closest(
						'a, button, input, select, textarea, [role="button"], .mac-window, .dock-btn',
					),
				),
			);
			updateTone(event);
		});
		document.addEventListener("mousedown", () =>
			document.body.classList.add("cup-cursor-pressed"),
		);
		document.addEventListener("mouseup", () =>
			document.body.classList.remove("cup-cursor-pressed"),
		);

		const animate = () => {
			cursorX += (mouseX - cursorX) * 0.15;
			cursorY += (mouseY - cursorY) * 0.15;
			cupCursor.style.left = `${cursorX}px`;
			cupCursor.style.top = `${cursorY}px`;
			requestAnimationFrame(animate);
		};
		animate();
	}
</script>
