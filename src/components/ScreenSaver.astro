<div
  id="site-screensaver"
  aria-hidden="true"
  role="presentation"
>
  <div id="screensaver-bouncer">
    <svg
      class="screensaver-cup"
      viewBox="0 0 40 48"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <clipPath id="screensaver-cup-clip" clipPathUnits="userSpaceOnUse">
          <path d="M6 11 L9 40 Q9 43 12 43 L28 43 Q31 43 31 40 L34 11 Z" />
        </clipPath>
      </defs>
      <rect
        class="screensaver-fill"
        x="4"
        y="11"
        width="30"
        height="34"
      />
      <line class="screensaver-steam" x1="13" y1="7" x2="13" y2="2" />
      <line class="screensaver-steam" x1="20" y1="5" x2="20" y2="0" />
      <line class="screensaver-steam" x1="27" y1="7" x2="27" y2="2" />
      <line class="screensaver-rim" x1="4" y1="11" x2="36" y2="11" />
      <path
        class="screensaver-body"
        d="M6 11 L9 40 Q9 43 12 43 L28 43 Q31 43 31 40 L34 11 Z"
      />
      <path
        class="screensaver-handle"
        d="M31 19 Q41 19 41 27 Q41 35 31 35"
      />
    </svg>
  </div>
</div>

<style>
  #site-screensaver {
    position: fixed;
    inset: 0;
    z-index: 10000;
    overflow: hidden;
    background: #e8321a;
    opacity: 0;
    pointer-events: none;
    transition: opacity 800ms ease;
  }

  #site-screensaver.is-visible {
    opacity: 1;
    pointer-events: all;
  }

  #site-screensaver::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 45%,
      rgba(180, 20, 0, 0.4) 100%
    );
    content: "";
  }

  #screensaver-bouncer {
    position: absolute;
    width: 80px;
    height: 96px;
    will-change: transform;
  }

  .screensaver-cup {
    width: 80px;
    height: 96px;
    overflow: visible;
  }

  .screensaver-steam {
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0;
  }

  .screensaver-steam.is-active {
    animation: screensaver-steam 900ms ease-out infinite;
  }

  .screensaver-steam:nth-of-type(2).is-active {
    animation-delay: 220ms;
  }

  .screensaver-steam:nth-of-type(3).is-active {
    animation-delay: 110ms;
  }

  @keyframes screensaver-steam {
    0% {
      opacity: 0;
      transform: translateY(3px);
    }
    35% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translateY(-9px);
    }
  }

  .screensaver-rim,
  .screensaver-body,
  .screensaver-handle {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    opacity: 0.45;
    transition: opacity 800ms ease;
  }

  .screensaver-rim {
    stroke-width: 1.8;
  }

  .screensaver-body {
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .screensaver-handle {
    stroke-width: 1.6;
  }

  .screensaver-rim.is-bright,
  .screensaver-body.is-bright,
  .screensaver-handle.is-bright {
    opacity: 1;
  }

  .screensaver-fill {
    fill: #1c0a06;
    clip-path: url(#screensaver-cup-clip);
    transform: translateY(100%);
    transition: transform 1200ms cubic-bezier(0.6, 0, 0.2, 1);
  }
</style>

<script>
  const screensaver = document.getElementById("site-screensaver");
  const bouncer = document.getElementById("screensaver-bouncer");
  const fill = screensaver?.querySelector<SVGRectElement>(
    ".screensaver-fill",
  );
  const steam = screensaver?.querySelectorAll<SVGElement>(
    ".screensaver-steam",
  );
  const outline = screensaver?.querySelectorAll<SVGElement>(
    ".screensaver-rim, .screensaver-body, .screensaver-handle",
  );

  if (screensaver && bouncer && fill && steam && outline) {
    const IDLE_MS = 30_000;
    const PX_PER_SEC = 65;
    const MIN_GAP = 1_800;
    const BOUNCER_WIDTH = 80;
    const BOUNCER_HEIGHT = 96;
    const FILLS = [
      "translateY(100%)",
      "translateY(67%)",
      "translateY(33%)",
      "translateY(0%)",
    ];

    let x = 100;
    let y = 100;
    let dx = 1;
    let dy = 0.77;
    let stage = 0;
    let lastHit = 0;
    let animationFrame = 0;
    let idleTimer = 0;
    let isRunning = false;
    let lastTime: number | null = null;
    let resetTimer = 0;

    const resetCup = () => {
      window.clearTimeout(resetTimer);
      stage = 0;
      fill.style.transform = FILLS[0];
      steam.forEach((item) => item.classList.remove("is-active"));
      outline.forEach((item) => item.classList.remove("is-bright"));
    };

    const onHit = () => {
      const now = Date.now();
      if (now - lastHit < MIN_GAP) return;
      lastHit = now;
      stage += 1;

      if (stage <= 3) {
        fill.style.transform = FILLS[stage];
      } else {
        resetTimer = window.setTimeout(resetCup, 1_800);
      }

      if (stage === 3) {
        steam.forEach((item) => item.classList.add("is-active"));
        outline.forEach((item) => item.classList.add("is-bright"));
      }
    };

    const tick = (timestamp: number) => {
      if (!lastTime) lastTime = timestamp;
      const delta = Math.min((timestamp - lastTime) / 1000, 0.05);
      lastTime = timestamp;
      x += dx * PX_PER_SEC * delta;
      y += dy * PX_PER_SEC * delta;

      const maxX = Math.max(0, window.innerWidth - BOUNCER_WIDTH);
      const maxY = Math.max(0, window.innerHeight - BOUNCER_HEIGHT);
      let hit = false;

      if (x <= 0) {
        x = 0;
        dx = Math.abs(dx);
        hit = true;
      }
      if (x >= maxX) {
        x = maxX;
        dx = -Math.abs(dx);
        hit = true;
      }
      if (y <= 0) {
        y = 0;
        dy = Math.abs(dy);
        hit = true;
      }
      if (y >= maxY) {
        y = maxY;
        dy = -Math.abs(dy);
        hit = true;
      }

      bouncer.style.transform = `translate(${x}px, ${y}px)`;
      if (hit) onHit();
      animationFrame = window.requestAnimationFrame(tick);
    };

    const hideScreensaver = () => {
      if (!isRunning) return;
      isRunning = false;
      screensaver.classList.remove("is-visible");
      screensaver.setAttribute("aria-hidden", "true");
      window.cancelAnimationFrame(animationFrame);
      window.clearTimeout(resetTimer);
      resetCup();
      lastTime = null;
      scheduleScreensaver();
    };

    const showScreensaver = () => {
      if (isRunning || document.visibilityState === "hidden") return;
      isRunning = true;
      lastTime = null;
      x = Math.random() * Math.max(0, window.innerWidth - BOUNCER_WIDTH);
      y = Math.random() * Math.max(0, window.innerHeight - BOUNCER_HEIGHT - 60);
      dx = Math.random() > 0.5 ? 1 : -1;
      dy = (Math.random() > 0.5 ? 1 : -1) * (0.6 + Math.random() * 0.5);
      resetCup();
      screensaver.classList.add("is-visible");
      screensaver.setAttribute("aria-hidden", "false");
      animationFrame = window.requestAnimationFrame(tick);
    };

    function scheduleScreensaver() {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(showScreensaver, IDLE_MS);
    }

    ["mousemove", "mousedown", "keydown", "touchstart", "scroll"].forEach(
      (eventName) => {
        document.addEventListener(
          eventName,
          () => {
            if (isRunning) hideScreensaver();
            else scheduleScreensaver();
          },
          { passive: true },
        );
      },
    );

    screensaver.addEventListener("click", hideScreensaver);
    screensaver.addEventListener("touchend", hideScreensaver, { passive: true });
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") hideScreensaver();
      else scheduleScreensaver();
    });
    window.addEventListener("resize", () => {
      if (!isRunning) return;
      x = Math.min(x, Math.max(0, window.innerWidth - BOUNCER_WIDTH));
      y = Math.min(y, Math.max(0, window.innerHeight - BOUNCER_HEIGHT));
    });

    scheduleScreensaver();
  }
</script>
