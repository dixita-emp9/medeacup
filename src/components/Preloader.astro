<div id="site-preloader" aria-label="Loading Medeacup" role="status">
  <div class="preloader-cup-wrap" id="preloader-cup">
    <svg class="preloader-cup" viewBox="0 0 40 48" aria-hidden="true">
      <defs>
        <clipPath id="preloader-cup-shape" clipPathUnits="userSpaceOnUse">
          <path d="M6 11 L9 40 Q9 43 12 43 L28 43 Q31 43 31 40 L34 11 Z" />
        </clipPath>
      </defs>
      <rect class="preloader-fill" x="4" y="11" width="30" height="34" />
      <line class="preloader-steam preloader-steam-1" x1="13" y1="7" x2="13" y2="2" />
      <line class="preloader-steam preloader-steam-2" x1="20" y1="5" x2="20" y2="0" />
      <line class="preloader-steam preloader-steam-3" x1="27" y1="7" x2="27" y2="2" />
      <line class="preloader-rim" x1="4" y1="11" x2="36" y2="11" pathLength="1" />
      <path class="preloader-body" d="M6 11 L9 40 Q9 43 12 43 L28 43 Q31 43 31 40 L34 11 Z" pathLength="1" />
      <path class="preloader-handle" d="M31 19 Q41 19 41 27 Q41 35 31 35" pathLength="1" />
    </svg>
  </div>

  <div class="preloader-letters" id="preloader-letters">
    <div class="preloader-letter-group">
      <div class="preloader-letter is-red">C</div>
      <div class="preloader-word">Clarity</div>
    </div>
    <div class="preloader-letter-group">
      <div class="preloader-letter">U</div>
      <div class="preloader-word">Uncommon Ideas</div>
    </div>
    <div class="preloader-letter-group">
      <div class="preloader-letter is-red">P</div>
      <div class="preloader-word">Power in Market</div>
    </div>
  </div>

  <div class="preloader-brand" id="preloader-brand">Medeacup</div>
  <div class="preloader-tagline" id="preloader-tagline">We find the 1% your market is waiting for.</div>
  <div class="preloader-progress"><div class="preloader-progress-fill"></div></div>
</div>

<div id="preloader-mini-cup" aria-hidden="true">
  <svg viewBox="0 0 40 48">
    <line x1="13" y1="7" x2="13" y2="2" />
    <line x1="20" y1="5" x2="20" y2="0" />
    <line x1="27" y1="7" x2="27" y2="2" />
    <line x1="4" y1="11" x2="36" y2="11" />
    <path d="M6 11 L9 40 Q9 43 12 43 L28 43 Q31 43 31 40 L34 11 Z" />
    <path d="M31 19 Q41 19 41 27 Q41 35 31 35" />
  </svg>
</div>

<style is:global>
  body.preloader-active { overflow: hidden !important; }

  #site-preloader {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #f7f4f1;
    color: #1c0a06;
    will-change: opacity, background-color;
  }

  .preloader-cup-wrap {
    width: 100px;
    height: 120px;
    margin-bottom: 44px;
    transform-origin: center;
    will-change: transform, opacity;
  }

  .preloader-cup { width: 100px; height: 120px; overflow: visible; }
  .preloader-steam {
    stroke: #e8321a;
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0;
  }
  .preloader-steam-1 { animation: preloader-steam-rise .9s ease-out 2.1s infinite; }
  .preloader-steam-2 { animation: preloader-steam-rise .9s ease-out 2.3s infinite; }
  .preloader-steam-3 { animation: preloader-steam-rise .9s ease-out 2.2s infinite; }
  @keyframes preloader-steam-rise {
    0% { opacity: 0; transform: translateY(5px); }
    35% { opacity: .7; }
    100% { opacity: 0; transform: translateY(-8px); }
  }

  .preloader-rim,
  .preloader-body,
  .preloader-handle {
    fill: none;
    stroke: #1c0a06;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: preloader-draw .9s cubic-bezier(.6, 0, .2, 1) .1s forwards;
  }
  .preloader-rim { animation-duration: .35s; animation-delay: 1.1s; }
  .preloader-handle { animation-duration: .4s; animation-delay: .7s; }
  @keyframes preloader-draw { to { stroke-dashoffset: 0; } }

  .preloader-fill {
    fill: #e8321a;
    clip-path: url(#preloader-cup-shape);
    transform: translateY(100%);
    animation: preloader-fill-rise .75s cubic-bezier(.6, 0, .2, 1) 1.55s forwards;
  }
  @keyframes preloader-fill-rise { to { transform: translateY(0); } }

  .preloader-letters {
    display: flex;
    align-items: flex-start;
    gap: 36px;
    margin-bottom: 24px;
    will-change: opacity;
  }
  .preloader-letter-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    opacity: 0;
    transform: translateY(14px);
    animation: preloader-letter-in .6s cubic-bezier(.16, 1, .3, 1) forwards;
  }
  .preloader-letter-group:nth-child(1) { animation-delay: 2.6s; }
  .preloader-letter-group:nth-child(2) { animation-delay: 2.85s; }
  .preloader-letter-group:nth-child(3) { animation-delay: 3.1s; }
  @keyframes preloader-letter-in { to { opacity: 1; transform: translateY(0); } }
  .preloader-letter {
    font-family: var(--font-heading);
    font-size: 54px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -2px;
  }
  .preloader-letter.is-red { color: #e8321a; }
  .preloader-word {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 7.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #a08078;
    white-space: nowrap;
  }
  .preloader-brand,
  .preloader-tagline { opacity: 0; animation: preloader-fade-up .6s cubic-bezier(.16, 1, .3, 1) 3.5s forwards; }
  .preloader-brand {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #a08078;
  }
  .preloader-tagline {
    margin-top: 7px;
    font-family: var(--font-heading);
    font-size: 11px;
    color: #c5afa8;
    letter-spacing: .3px;
    animation-delay: 3.7s;
  }
  @keyframes preloader-fade-up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .preloader-progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: rgba(28, 10, 6, .06);
  }
  .preloader-progress-fill {
    width: 0;
    height: 100%;
    background: #e8321a;
    animation: preloader-progress 4s cubic-bezier(.4, 0, .6, 1) .1s forwards;
  }
  @keyframes preloader-progress { to { width: 100%; } }

  #preloader-mini-cup {
    position: fixed;
    z-index: 10000;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity .25s ease;
  }
  #preloader-mini-cup.is-visible { opacity: 1; }
  #preloader-mini-cup svg { width: 36px; height: 42px; overflow: visible; }
  #preloader-mini-cup line,
  #preloader-mini-cup path { fill: none; stroke: #e8321a; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  #preloader-mini-cup path:first-of-type { fill: #e8321a; }
  #preloader-mini-cup line { animation: preloader-mini-steam .85s ease-in-out infinite alternate; }
  #preloader-mini-cup line:nth-child(2) { animation-delay: .28s; }
  #preloader-mini-cup line:nth-child(3) { animation-delay: .56s; }
  @keyframes preloader-mini-steam { from { opacity: .2; transform: translateY(0); } to { opacity: .75; transform: translateY(-3px); } }

  @media (max-width: 480px) {
    .preloader-cup-wrap { width: 80px; height: 96px; margin-bottom: 32px; }
    .preloader-cup { width: 80px; height: 96px; }
    .preloader-letters { gap: 18px; }
    .preloader-letter { font-size: 38px; letter-spacing: -1px; }
    .preloader-word { font-size: 6.5px; letter-spacing: 1px; }
    .preloader-brand { font-size: 10px; letter-spacing: 3px; }
    .preloader-tagline { font-size: 10px; }
  }
</style>

<script>
  const preloader = document.getElementById("site-preloader");
  const preloaderCup = document.getElementById("preloader-cup");
  const preloaderLetters = document.getElementById("preloader-letters");
  const preloaderBrand = document.getElementById("preloader-brand");
  const preloaderTagline = document.getElementById("preloader-tagline");
  const miniCup = document.getElementById("preloader-mini-cup");

  document.body.classList.add("preloader-active");

  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;
  document.addEventListener("mousemove", (event) => {
    mouseX = event.clientX;
    mouseY = event.clientY;
    if (miniCup) {
      miniCup.style.left = `${mouseX}px`;
      miniCup.style.top = `${mouseY}px`;
    }
  });

  const exitPreloader = () => {
    [preloaderLetters, preloaderBrand, preloaderTagline].forEach((element) => {
      if (!element) return;
      element.style.transition = "opacity .35s ease";
      element.style.opacity = "0";
    });

    window.setTimeout(() => {
      if (!preloader || !preloaderCup) return;
      preloader.style.transition = "background-color .7s ease";
      preloader.style.backgroundColor = "transparent";

      const rect = preloaderCup.getBoundingClientRect();
      const cupCenterX = rect.left + rect.width / 2;
      const cupCenterY = rect.top + rect.height / 2;
      preloaderCup.style.transition = "transform .65s cubic-bezier(.76, 0, .24, 1)";
      preloaderCup.style.transform = `translate(${(mouseX - cupCenterX) * .6}px, ${(mouseY - cupCenterY) * .6}px) scale(.36)`;

      window.setTimeout(() => {
        miniCup?.classList.add("is-visible");
        preloaderCup.style.transition = "opacity .2s ease";
        preloaderCup.style.opacity = "0";

        window.setTimeout(() => {
          preloader?.remove();
          miniCup?.classList.remove("is-visible");
          document.body.classList.remove("preloader-active");
        }, 220);
      }, 600);
    }, 380);
  };

  window.setTimeout(exitPreloader, 4000);
</script>
