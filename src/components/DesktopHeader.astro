---
---

<header class="desktop-header">
  <div class="logo-container">
    <span class="logo-text">MEDEACUP</span>
  </div>

  <div class="top-status-dots">
    <span class="status-circle"></span>
    <span class="status-circle"></span>
  </div>
</header>

<style>
  .desktop-header {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
    z-index: 5;
    pointer-events: none;
  }

  .logo-container {
    pointer-events: auto;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 800;
    color: var(--brand-red);
    letter-spacing: -0.02em;
    display: inline-block;
    text-transform: uppercase;
    filter: drop-shadow(0 3px 6px rgba(230, 46, 45, 0.2));
  }

  .top-status-dots {
    display: flex;
    align-items: center;
    gap: 14px;
    pointer-events: auto;
  }

  .status-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #eae5d7;
    border: 2px solid rgba(255, 255, 255, 0.8);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: transform var(--transition-bounce), background-color var(--transition-fast);
    cursor: pointer;
  }

  .status-circle:hover {
    transform: scale(1.15);
    background-color: var(--brand-red);
  }
</style>
