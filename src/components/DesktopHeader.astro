---
---

<header class="desktop-header">
  <div class="logo-container">
    <span class="logo-text">MEDEACUP</span>
  </div>

  <div class="top-status-dots">
    <span class="status-circle status-user" aria-label="Profile">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="currentColor"/><path d="M5.5 19c.8-3.1 3-4.7 6.5-4.7s5.7 1.6 6.5 4.7" fill="currentColor"/></svg>
    </span>
    <span class="status-circle status-mail" aria-label="Contact us">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="m5.5 8 5 4a2.5 2.5 0 0 0 3 0l5-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </span>
  </div>
</header>

<style>
  .desktop-header {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
    z-index: 5;
    pointer-events: none;
  }

  .logo-container {
    pointer-events: auto;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 800;
    color: var(--brand-red);
    letter-spacing: -0.02em;
    display: inline-block;
    text-transform: uppercase;
    filter: drop-shadow(0 3px 6px rgba(230, 46, 45, 0.2));
  }

  .top-status-dots {
    display: flex;
    align-items: center;
    gap: 14px;
    pointer-events: auto;
  }

  .status-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #eae5d7;
    border: 2px solid rgba(255, 255, 255, 0.8);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: transform var(--transition-bounce), background-color var(--transition-fast);
    cursor: pointer;
  }

  .status-circle svg {
    display: none;
  }

  .status-circle:hover {
    transform: scale(1.15);
    background-color: var(--brand-red);
  }

  @media (max-width: 720px) {
    .desktop-header {
      top: 34px;
      height: 62px;
      padding: 0 40px;
      align-items: center;
    }

    .logo-text {
      font-size: clamp(28px, 7.6vw, 40px);
      letter-spacing: -0.055em;
      filter: none;
    }

    .top-status-dots {
      gap: 12px;
    }

    .status-circle {
      width: 54px;
      height: 54px;
      border: 0;
      background: #383838;
      color: #fff;
      box-shadow: none;
    }

    .status-circle svg {
      display: block;
      width: 29px;
      height: 29px;
    }

    .status-circle:hover {
      background: #383838;
      transform: none;
    }
  }
</style>
