---
const dockItems = [
  { id: 'dock-home', label: 'Home', icon: 'home', isRed: true },
  { id: 'dock-percent', label: '1% Principle', icon: 'percent', isRed: false },
  { id: 'dock-folder', label: 'Cases & Projects', icon: 'folder', isRed: false },
  { id: 'dock-bulb', label: 'Framework', icon: 'bulb', isRed: false },
  { id: 'dock-mail', label: 'Contact Us', icon: 'mail', isRed: false }
];
---

<div class="dock-wrapper">
  <div class="mac-dock-bar">
    {dockItems.map(item => (
      <button class={`dock-btn ${item.isRed ? 'is-active-home' : ''}`} data-dock-id={item.id} title={item.label}>
        {item.icon === 'home' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        )}
        {item.icon === 'percent' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
        )}
        {item.icon === 'folder' && (
          <div class="dock-folder-group">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <div class="dock-stack" data-dock-stack>
              <div class="ds-item" style="--index: 0; --delay: 0.15s;" data-action-target="win-principle">
                <div class="ds-icon doc-c">
                  <svg width="40" height="48" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 0H32L44 12V52C44 54.2091 42.2091 56 40 56H4C1.79086 56 0 54.2091 0 52V4C0 1.79086 1.79086 0 4 0Z" fill="#EFE8DA"/><path d="M32 0L44 12H36C33.7909 12 32 10.2091 32 8V0Z" fill="#DDD5C3"/><text x="50%" y="60%" font-family="var(--font-display)" font-size="22" font-weight="500" fill="#B8AE9C" text-anchor="middle">1%</text></svg>
                </div>
                <div class="ds-pill">The 1% Principle</div>
              </div>

              <div class="ds-item" style="--index: 1; --delay: 0.12s;" data-action-target="modal-page-cases">
                <div class="ds-icon doc-lines">
                  <svg width="40" height="48" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 0H32L44 12V52C44 54.2091 42.2091 56 40 56H4C1.79086 56 0 54.2091 0 52V4C0 1.79086 1.79086 0 4 0Z" fill="#EFE8DA"/><path d="M32 0L44 12H36C33.7909 12 32 10.2091 32 8V0Z" fill="#DDD5C3"/><line x1="8" y1="20" x2="28" y2="20" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/><line x1="8" y1="28" x2="24" y2="28" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/></svg>
                </div>
                <div class="ds-pill">Cup Cases</div>
              </div>

              <div class="ds-item" style="--index: 2; --delay: 0.09s;" data-action-target="modal-page-framework">
                <div class="ds-icon doc-c">
                  <svg width="40" height="48" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 0H32L44 12V52C44 54.2091 42.2091 56 40 56H4C1.79086 56 0 54.2091 0 52V4C0 1.79086 1.79086 0 4 0Z" fill="#EFE8DA"/><path d="M32 0L44 12H36C33.7909 12 32 10.2091 32 8V0Z" fill="#DDD5C3"/><text x="50%" y="60%" font-family="var(--font-display)" font-size="22" font-weight="500" fill="#B8AE9C" text-anchor="middle">C</text></svg>
                </div>
                <div class="ds-pill">Cup Framework</div>
              </div>

              <div class="ds-item" style="--index: 3; --delay: 0.06s;" data-action-target="modal-page-capabilities">
                <div class="ds-icon folder">
                  <svg width="48" height="38" viewBox="0 0 70 54" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M66 12H34L28 4H4C1.79086 4 0 5.79086 0 8V46C0 48.2091 1.79086 50 4 50H66C68.2091 50 70 48.2091 70 46V16C70 13.7909 68.2091 12 66 12Z" fill="#EFE8DA"/><path d="M34 12H66C68.2091 12 70 13.7909 70 16V18H0V8C0 5.79086 1.79086 4 4 4H28L34 12Z" fill="#DDD5C3"/></svg>
                </div>
                <div class="ds-pill">Core Capabilities</div>
              </div>

              <div class="ds-item" style="--index: 4; --delay: 0.03s;" data-action-target="modal-page-about">
                <div class="ds-icon doc-lines">
                  <svg width="40" height="48" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 0H32L44 12V52C44 54.2091 42.2091 56 40 56H4C1.79086 56 0 54.2091 0 52V4C0 1.79086 1.79086 0 4 0Z" fill="#EFE8DA"/><path d="M32 0L44 12H36C33.7909 12 32 10.2091 32 8V0Z" fill="#DDD5C3"/><line x1="8" y1="20" x2="28" y2="20" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/><line x1="8" y1="28" x2="24" y2="28" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/></svg>
                </div>
                <div class="ds-pill">About Us</div>
              </div>

              <div class="ds-item" style="--index: 5; --delay: 0s;" data-action-target="modal-page-work">
                <div class="ds-icon folder">
                  <svg width="48" height="38" viewBox="0 0 70 54" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M66 12H34L28 4H4C1.79086 4 0 5.79086 0 8V46C0 48.2091 1.79086 50 4 50H66C68.2091 50 70 48.2091 70 46V16C70 13.7909 68.2091 12 66 12Z" fill="#EFE8DA"/><path d="M34 12H66C68.2091 12 70 13.7909 70 16V18H0V8C0 5.79086 1.79086 4 4 4H28L34 12Z" fill="#DDD5C3"/></svg>
                </div>
                <div class="ds-pill">Where We Work</div>
              </div>
            </div>
          </div>
        )}
        {item.icon === 'bulb' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
        )}
        {item.icon === 'mail' && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        )}
      </button>
    ))}
  </div>
</div>

<style>
  .dock-wrapper {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
  }

  .mac-dock-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    border-radius: 36px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.1);
  }

  .dock-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: #ffffff;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--transition-bounce), background-color var(--transition-fast), color var(--transition-fast);
  }

  .dock-btn.is-active-home {
    color: var(--brand-red);
    border-color: rgba(230, 46, 45, 0.3);
  }

  /* macOS Dock Magnification Hover Effect */
  .dock-btn:hover {
    transform: scale(1.35) translateY(-10px);
    background-color: #ffffff;
    color: var(--brand-red);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
  }

  .dock-btn:active {
    transform: scale(1.15) translateY(-2px);
  }
  
  /* Dock Stack Animation (macOS Curved Fan with Pills) */
  .dock-folder-group {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .dock-stack {
    position: absolute;
    bottom: 54px;
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    height: 360px;
    pointer-events: none;
    z-index: 100;
  }

  .dock-stack.is-open {
    pointer-events: auto;
  }

  .ds-item {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%) translateY(14px) scale(0.68);
    opacity: 0;
    display: flex;
    flex-direction: row-reverse; /* Put pills on the left */
    align-items: center;
    gap: 10px;
    transition: transform 360ms cubic-bezier(.22,1,.36,1), opacity 220ms ease, filter 220ms ease;
    cursor: pointer;
    transform-origin: center center;
    filter: saturate(0.95);
    will-change: transform, opacity;
  }

  .dock-stack.is-open .ds-item {
    opacity: 1;
    transform: translateX(-50%) translateY(calc(-74px - (var(--index) * 56px))) scale(1);
  }

  /* Individual item hover effects inside the stack */
  .ds-item:hover {
    z-index: 10;
    transform: translateX(-50%) translateY(calc(-84px - (var(--index) * 56px))) scale(1.08) !important;
  }

  .ds-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 5px 14px rgba(0,0,0,0.10));
    transition: filter 0.2s ease;
  }

  .ds-item:hover .ds-icon {
    filter: drop-shadow(0 16px 24px rgba(0,0,0,0.15));
  }

  .ds-pill {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 10px 18px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.94);
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
    box-shadow: 0 10px 24px rgba(0,0,0,0.08);
  }

  .ds-item:hover .ds-pill {
    background: rgba(255, 255, 255, 0.95);
    color: var(--text-primary);
  }

  .dock-stack::before { content: ''; position: absolute; inset: auto 50% 8px; width: 64px; height: 64px; transform: translateX(-50%); border-radius: 18px; background: rgba(255,255,255,0.25); filter: blur(18px); opacity: 0; transition: opacity 220ms ease; }
  .dock-stack.is-open::before { opacity: 1; }
</style>
