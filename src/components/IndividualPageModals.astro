  /* Mobile overrides */
  @media (max-width: 900px) {
    .fw-mobile-grid-view {
      display: block;
    }
    #fw-desktop-canvas {
      display: none !important; /* hidden by default on mobile, shown via JS */
      flex-direction: column;
      padding: 100px 24px 40px;
      overflow-y: auto;
    }

    /* Detail View Active State */
    #modal-page-framework.is-mobile-detail .fw-mobile-grid-view {
      display: none !important;
    }
    #modal-page-framework.is-mobile-detail #fw-desktop-canvas {
      display: flex !important;
    }
    .fw-sidebar {
      display: none !important; /* hide sidebar on mobile */
    }
    .fw-watermark {
      position: relative !important;
      right: auto !important;
      bottom: auto !important;
      align-items: flex-start !important;
      margin-top: 60px;
      margin-bottom: 60px;
      opacity: 0.6;
      order: 3;
    }
    .fw-watermark-text {
      text-align: left !important;
      font-size: 24px !important;
      color: rgba(91, 81, 70, 0.7) !important;
    }

    .fw-popover-card {
      position: relative !important;
      left: 0 !important;
      top: 0 !important;
      transform: none !important;
      width: 100% !important;
      padding: 32px 24px !important;
      background: #f1efe9 !important;
      border-radius: 24px !important;
      box-shadow: none !important;
      border: none !important;
      display: none; /* hide inactive cards */
      order: 1;
    }
    .fw-popover-card.is-active {
      display: block;
    }
    .fw-popover-arrow,
