        <span class="dot-btn dot-cream"></span>
        <span class="dot-btn dot-cream"></span>
      </div>
    </div>
    
    <div class="fw-canvas-body">
      <!-- Watermark Background -->
      <div class="fw-watermark">
        <div class="fw-bulb">💡</div>
        <div class="fw-watermark-text">Clarity first. Then the idea nobody expects.<br>Then the number that moves.</div>
      </div>

      <!-- Left Sidebar: C-U-P Icons -->
