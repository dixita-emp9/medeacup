  /* Where We Work — MacBook Air-22 orbital client map */
  .where-window-body {
    min-height: 0;
    padding: 0;
    background: #f6f1e8;
    overflow: hidden;
    flex: 1;
    display: flex;
  }

  .where-canvas {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 520px;
  }

  /* ── Client card: file icon + label ── */
  .where-client-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  /* The file icon shape with dog-ear corner */
  .where-file-icon {
    position: relative;
    width: 148px;
    height: 172px;
    filter: drop-shadow(0 14px 30px rgba(60,50,35,0.12));
  }

  /* Main body of the file */
  .where-file-body {
    position: absolute;
    inset: 0;
    background: #eee8da;
    border-radius: 4px 4px 6px 6px;
    clip-path: polygon(0 0, 72% 0, 100% 22%, 100% 100%, 0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 8px 8px;
  }

  /* Dog-ear triangle — top right folded corner */
  .where-file-icon::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40px;
    height: 36px;
    background: linear-gradient(225deg, #d8d0c0 50%, transparent 50%);
    border-radius: 0 4px 0 0;
    z-index: 2;
  }

  .where-logo {
    width: 108px;
    height: 72px;
    object-fit: contain;
    object-position: center;
  }

  /* Client name label below icon */
  .where-client-label {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(55,55,55,0.65);
  }

  /* ── Positions — spread around the centered glob ── */
  .where-godrej   { left: 4%;   top: 10%; }
  .where-fctrylab { left: 12%;  top: 52%; }
  .where-reverb   { right: 24%; top: 8%;  }
  .where-fabindia { right: 4%;  top: 34%; }
  .where-jacobs   { right: 12%; top: 54%; }

  /* ── Orbital diagram — truly centered ── */
  .where-orbit-field {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 620px;
    height: 560px;
    transform: translate(-50%, -50%);
  }

  .where-glob-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  /* India pill — canvas-level, above the glob */
  .where-country-pill {
    position: absolute;
    top: 14%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border: 1px solid rgba(80,75,68,0.18);
    border-radius: 20px;
    background: rgba(246,241,232,0.95);
    backdrop-filter: blur(8px);
    color: rgba(65,65,65,0.78);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    z-index: 10;
  }

  /* ── Sector filter pills ── */
  .where-sector-filters {
    position: absolute;
    bottom: 6%;
    left: 50%;
    display: flex;
    gap: 8px;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .where-sector-filters button {
    padding: 10px 20px;
