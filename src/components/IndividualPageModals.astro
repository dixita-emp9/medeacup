    width: 18px;
    height: 18px;
    color: #9b9b98;
  }

  .fw-search-bar input {
    width: 100%;
    height: 48px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #f7f3eb;
    border-radius: 24px;
    padding: 0 16px 0 44px;
    font-size: 16px;
