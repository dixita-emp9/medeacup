---
---

<div class="mac-window glass-window window-quiz" id="win-quiz" style="top: 420px; left: 24%; width: 24vw; min-width: 320px; max-width: 380px;">
  <div class="window-header">
    <span class="window-title-tag">Are we compatible?</span>
  </div>

  <div class="quiz-content">
    <div class="brain-grid-visual">
      <img 
        src="https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=500&q=80" 
        alt="Compatibility Quiz Graphics"
        width="500"
        height="270"
        loading="lazy"
        decoding="async"
        class="quiz-img"
      />
    </div>

    <div class="quiz-footer">
      <button class="quiz-btn" id="btn-take-quiz">
        Take the quiz
      </button>

      <div class="preview-text-lines">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</div>

<style>
  .window-quiz {
    height: 420px;
    border-radius: 26px;
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .quiz-content {
    padding: 14px 18px 20px 18px;
    display: flex;
    flex-direction: column;
    height: calc(100% - 44px);
    justify-content: space-between;
  }

  .brain-grid-visual {
    width: 100%;
    height: 270px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .quiz-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.96) contrast(1.06);
  }

  .quiz-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
  }

  .quiz-btn {
    background-color: #18181b;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 24px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  }

  .quiz-btn:hover {
    background-color: #27272a;
    transform: scale(1.05);
  }

  .quiz-btn:active {
    transform: scale(0.96);
  }

  .preview-text-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 90px;
  }

  .preview-text-lines span {
    height: 4px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 2px;
  }

  .preview-text-lines span:nth-child(1) { width: 100%; }
  .preview-text-lines span:nth-child(2) { width: 85%; }
  .preview-text-lines span:nth-child(3) { width: 60%; }
</style>
