    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes mobileSlideFromRight {
    from {
      opacity: 0.35;
      transform: translateX(28px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes mobileSlideFromLeft {
    from {
      opacity: 0.35;
      transform: translateX(-28px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<script>
  const updateClock = () => {
    const now = new Date();
    const minutes = now.getMinutes() + now.getSeconds() / 60;
    const hours = (now.getHours() % 12) + minutes / 60;

    const hourTransform = `translateX(-50%) rotate(${hours * 30}deg)`;
    const minuteTransform = `translateX(-50%) rotate(${minutes * 6}deg)`;
    document
      .querySelectorAll<HTMLElement>(".clock-hour, .mobile-clock-hour")
      .forEach((hand) => (hand.style.transform = hourTransform));
    document
      .querySelectorAll<HTMLElement>(".clock-minute, .mobile-clock-minute")
      .forEach((hand) => (hand.style.transform = minuteTransform));
  };

  updateClock();
  window.setInterval(updateClock, 1000);
</script>
