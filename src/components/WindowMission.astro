---
---

<div class="mac-window window-mission" id="win-mission" style="top: 90px; left: 31%; width: 33vw; min-width: 440px; max-width: 580px;">
  <div class="window-header">
    <span class="window-title-tag">Our Mission</span>
    <div class="window-dots">
      <span class="dot-btn dot-black"></span>
      <span class="dot-btn dot-black"></span>
      <span class="dot-btn dot-black"></span>
      <span class="dot-btn dot-red"></span>
    </div>
  </div>

  <div class="mission-content">
    <div class="mission-bg-visual">
      <div class="red-sparkle s1"></div>
      <div class="red-sparkle s2"></div>
      <div class="red-sparkle s3"></div>
      <div class="red-sparkle s4"></div>
      <div class="red-sparkle s5"></div>
      <div class="red-sparkle s6"></div>
    </div>

    <h2 class="mission-headline">
      We find <br />
      the 1% your <br />
      market is <br />
      waiting for.
    </h2>

    <button class="learn-more-btn" id="btn-learn-more">
      Learn More
    </button>
  </div>
</div>

<style>
  .window-mission {
    height: 560px;
    background: linear-gradient(180deg, #fdfbf7 0%, #f4f0e6 100%);
    border-radius: 28px;
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mission-content {
    position: relative;
    height: calc(100% - 44px);
    padding: 48px 36px 40px 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .mission-bg-visual {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 50% 40%, rgba(240, 235, 220, 0.85) 0%, transparent 75%),
      radial-gradient(circle at 20% 80%, rgba(230, 46, 45, 0.1) 0%, transparent 45%),
      radial-gradient(circle at 80% 20%, rgba(230, 46, 45, 0.08) 0%, transparent 40%);
    pointer-events: none;
  }

  .red-sparkle {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--brand-red);
    box-shadow: 0 0 10px var(--brand-red);
  }

  .s1 { top: 22%; left: 18%; }
  .s2 { top: 28%; right: 20%; }
  .s3 { bottom: 38%; left: 14%; }
  .s4 { bottom: 30%; right: 16%; }
  .s5 { top: 50%; left: 10%; }
  .s6 { bottom: 18%; right: 24%; }

  .mission-headline {
    position: relative;
    font-family: var(--font-heading);
    font-size: clamp(34px, 3.2vw, 48px);
    font-weight: 800;
    line-height: 1.12;
    color: #111111;
    margin-bottom: 42px;
    letter-spacing: -0.03em;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.04));
  }

  .learn-more-btn {
    position: relative;
    background: linear-gradient(135deg, #e62e2d 0%, #d41f1e 100%);
    color: white;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    padding: 16px 44px;
    border-radius: 30px;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(230, 46, 45, 0.4);
    transition: transform var(--transition-bounce), box-shadow var(--transition-fast);
  }

  .learn-more-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 30px rgba(230, 46, 45, 0.5);
  }

  .learn-more-btn:active {
    transform: scale(0.97);
  }
</style>
