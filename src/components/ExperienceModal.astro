    background: #f7f3eb;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .experience-file-glyph {
    position: relative;
    display: block;
