    clip-path: polygon(0 0, 68% 0, 100% 24%, 100% 100%, 0 100%);
  }
  .experience-file-glyph::before {
    content: "";
    position: absolute;
    top: 19px;
    left: 10px;
    width: 25px;
    height: 3px;
    border-radius: 3px;
    background: #b8ae9c;
    box-shadow:
      0 8px 0 #b8ae9c,
      0 16px 0 #b8ae9c;
  }
  .experience-doc-label {
    font: 600 15px var(--font-body);
    color: var(--text-primary);
    text-align: center;
    white-space: nowrap;
  }
  .experience-doc-item:hover .experience-doc-icon {
    transform: translateY(-3px);
    box-shadow: 0 18px 38px rgba(71, 63, 52, 0.16);
  }
  .experience-detail-view {
    flex: 1;
    min-height: 0;
  }
  .experience-detail-content {
    height: calc(100% - 58px);
    display: grid;
    place-items: center;
    padding: 36px;
    text-align: center;
  }
  .experience-detail-content .cs-headline {
    margin: 0;
  }
  .experience-doc-item:hover .experience-doc-icon {
    transform: translateY(-3px);
    box-shadow: 0 18px 38px rgba(71, 63, 52, 0.16);
  }
  @media (max-width: 900px) {
    .experience-grid-view {
      padding: 28px 20px 60px;
    }
    .experience-folder-grid {
      gap: 32px 18px;
    }
  }
  @media (max-width: 600px) {
    .experience-folder-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .experience-doc-item {
      min-width: 0;
    }
    .experience-doc-label {
      white-space: normal;
    }
  }
</style>
