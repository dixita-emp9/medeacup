<div class="modal-overlay" id="modal-page-experience">
  <div class="fullscreen-mac-window experience-window">
    <div class="mobile-modal-nav">
      <button
        type="button"
        class="mobile-nav-back close-modal-btn"
        data-close-target="modal-page-experience"
        aria-label="Back">‹</button
      >
      <div class="mobile-nav-title">Experience Design</div>
      <button type="button" class="mobile-nav-more" aria-label="More options"
        ><i></i><i></i><i></i></button
      >
    </div>
    <div class="fullscreen-window-header">
      <div class="browser-tab-strip" aria-label="Open pages">
        <button type="button" class="browser-tab is-active"
          >Experience Design <span aria-hidden="true">×</span></button
        >
      </div>
      <div class="fullscreen-window-controls">
        <span
          class="dot-btn dot-red close-modal-btn"
          data-close-target="modal-page-experience"></span>
        <span class="dot-btn dot-cream"></span><span class="dot-btn dot-cream"
        ></span>
      </div>
    </div>

    <div class="experience-grid-view" id="experience-view-grid">
      <div class="experience-intro">
        <h1>Design what happens when people choose you.</h1>
        <h2>A choice is only the beginning.</h2>
        <p>
          Someone discovers you. They consider you. They choose you. Then the
          real experience begins. What happens next can change memory,
          preference, return, recommendation and revenue. We design that space.
        </p>
      </div>
      <div class="experience-folder-grid cases-document-grid">
        {
          [
            "The Idea",
            "The Sequence",
            "Before",
            "During",
            "After",
            "The Preference Loop",
            "Hospitality",
            "D2C",
            "The Commercial Layer",
          ].map((name) => (
            <button
              class="experience-doc-item case-doc-item"
              type="button"
              data-experience-id={name}
            >
              <span
                class="experience-doc-icon case-doc-icon"
                aria-hidden="true"
              >
                <span class="experience-file-glyph" />
              </span>
              <span class="experience-doc-label case-doc-label">{name}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="experience-detail-view" id="experience-view-detail" hidden>
      <div class="cs-subtab-bar">
        <button
          class="cs-back-btn"
          id="experience-back-to-grid"
          type="button"
          aria-label="Back to Experience Design">‹</button
        >
        <button
          class="cs-subtab is-active"
          id="experience-detail-tab"
          type="button">Experience Design</button
        >
      </div>
      <div class="experience-detail-content">
        <h1 class="cs-headline" id="experience-detail-title">
          Experience Design
        </h1>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(16px);
    z-index: 2000;
    transition: opacity 0.25s ease;
  }
  .modal-overlay.is-open {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }
  .experience-window .mobile-modal-nav {
    display: none;
  }
  .experience-window .fullscreen-window-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
  }
  .experience-window .fullscreen-window-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .experience-window .dot-btn {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .experience-window .dot-btn::after {
    content: "";
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .experience-window .dot-red {
    color: var(--brand-red);
  }
  .experience-window .dot-cream {
    color: #ddd7c3;
  }
  .experience-grid-view {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 40px 64px;
  }
  .experience-intro {
    width: 100%;
    margin: 0 0 34px;
    text-align: left;
  }
  .experience-intro h1 {
    margin: 10px 0 8px;
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 500;
    line-height: 1.03;
  }
  .experience-intro h2 {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .experience-intro p {
    width: 100%;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .experience-folder-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(140px, 1fr));
    gap: 48px 36px;
    align-items: start;
  }
  .experience-doc-item {
